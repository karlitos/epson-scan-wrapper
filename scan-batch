#!/usr/bin/env bash
#
# scan-batch — group Epson ET-3700 flatbed scans into one OCR'd, searchable PDF.
#
# WHAT THIS IS
#   A thin, host-side terminal wrapper around the stock `epson2paperless` daemon.
#   The ET-3700 is flatbed-only: each panel press of Scan -> Computer -> Paperless
#   produces exactly ONE file. There is no session grouping on the device. This
#   script drives the daemon, watches its output folder for new per-page scans,
#   lets you press ENTER when the batch is done, then merges the pages (in scan
#   order) into a single multi-page PDF and runs OCR so the PDF is searchable.
#
# RELATIONSHIP TO epson2paperless
#   This wrapper is INTENTIONALLY SEPARATE from and does NOT modify the
#   epson2paperless repo. It only uses that project's public surface: the
#   PRINTER_IP / OUTPUT_DIR env vars, `npm run dev`, and its stdout log lines.
#   epson2paperless deliberately keeps OCR/merge logic out; this host-side layer
#   adds it and becomes optional once Paperless-ngx does server-side OCR.
#
# COMPATIBILITY
#   Targets macOS system bash 3.2 (/bin/bash). Avoids bash-4 features: no
#   associative arrays, no `wait -n`, no `${var,,}`, no mapfile/readarray.
#
set -euo pipefail

# ---------------------------------------------------------------------------
# Defaults (all overridable via flags / env)
# ---------------------------------------------------------------------------
PRINTER_IP="${PRINTER_IP:-192.168.178.3}"
E2P_DIR="${E2P_DIR:-$HOME/Dev/epson2paperless}"
OUT_DIR="${OUT_DIR:-$HOME/Documents/Scans}"
STAGING=""                       # derived <OUT_DIR>/.work unless set via --staging
OCR_LANGS="${OCR_LANGS:-deu+eng}"
SCAN_PORT=2968                   # epson2paperless discovery/scan port
READY_TIMEOUT=30                 # seconds to wait for daemon readiness
SELF_TEST=0
NO_DAEMON=0

# Runtime state used by cleanup()
DAEMON_PGID=""
RUN_STATUS="aborted"             # ok | failed | aborted
EXIT_CODE=1
MERGED_TMP=""                    # intermediate merged (pre-OCR) PDF path
SIDECAR_TMP=""                   # optional ocr sidecar path
DAEMON_LOG=""
ASSEMBLER=""                     # img2pdf | magick
STAGING_READY=0                  # 1 once STAGING is created (safe to clean)

# Track staged pages this run created so cleanup is scoped to the batch.
STAGED_PAGES=""                  # newline-separated absolute paths

usage() {
  cat <<'EOF'
scan-batch — group Epson ET-3700 flatbed scans into one OCR'd, searchable PDF.

USAGE
  scan-batch [OUTPUT_DIR] [options]

OPTIONS
  --out <dir>           Output folder for the finished PDF.
                        Default: ~/Documents/Scans
                        (a positional first argument is also accepted as OUTPUT_DIR)
  --staging <dir>       Hidden work folder for raw per-page scans.
                        Default: <OUTPUT_DIR>/.work
  --printer-ip <ip>     Printer IP for the daemon. Default: 192.168.178.3
  --e2p <path>          Path to the epson2paperless checkout.
                        Default: ~/Dev/epson2paperless
  --langs <langs>       OCR languages for ocrmypdf -l. Default: deu+eng
  --self-test           Run the offline self-test (no daemon, no scanner) and exit.
  --no-daemon           Skip helper-app quit + daemon startup (file-based mode).
  -h, --help            Show this help and exit.

The flow: run it, scan each page as JPEG from the printer panel
(Scan -> Computer -> Paperless -> Save as JPEG), press ENTER when done, then
name the document. Pages merge in scan order into one searchable PDF.
EOF
}

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------
log()  { printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
err()  { printf 'ERROR: %s\n' "$*" >&2; }

die() {
  err "$*"
  exit 1
}

# Expand a leading ~ to $HOME (quotes prevent the shell doing it for us).
expand_tilde() {
  case "$1" in
    "~")   printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s\n' "$HOME/${1#\~/}" ;;
    *)     printf '%s\n' "$1" ;;
  esac
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
parse_args() {
  local positional_out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --out)        shift; [ $# -gt 0 ] || die "--out needs a value"; OUT_DIR="$(expand_tilde "$1")" ;;
      --staging)    shift; [ $# -gt 0 ] || die "--staging needs a value"; STAGING="$(expand_tilde "$1")" ;;
      --printer-ip) shift; [ $# -gt 0 ] || die "--printer-ip needs a value"; PRINTER_IP="$1" ;;
      --e2p)        shift; [ $# -gt 0 ] || die "--e2p needs a value"; E2P_DIR="$(expand_tilde "$1")" ;;
      --langs)      shift; [ $# -gt 0 ] || die "--langs needs a value"; OCR_LANGS="$1" ;;
      --self-test)  SELF_TEST=1; NO_DAEMON=1 ;;
      --no-daemon)  NO_DAEMON=1 ;;
      -h|--help)    usage; exit 0 ;;
      --)           shift; break ;;
      -*)           die "unknown option: $1 (see --help)" ;;
      *)            if [ -z "$positional_out" ]; then positional_out="$1"; else die "unexpected argument: $1"; fi ;;
    esac
    shift
  done
  # positional OUTPUT_DIR applies only if --out was not given (OUT_DIR still default-ish);
  # treat an explicit positional as authoritative when present.
  if [ -n "$positional_out" ]; then
    OUT_DIR="$(expand_tilde "$positional_out")"
  fi
  if [ -z "$STAGING" ]; then
    STAGING="$OUT_DIR/.work"
  fi
}

# ---------------------------------------------------------------------------
# Preflight / dependency checks
# ---------------------------------------------------------------------------
preflight() {
  command -v ocrmypdf >/dev/null 2>&1 || die "ocrmypdf not found. Install with: brew install ocrmypdf"
  command -v tesseract >/dev/null 2>&1 || die "tesseract not found. Install with: brew install tesseract tesseract-lang"

  # Verify requested OCR languages are installed.
  local installed missing lang
  installed="$(tesseract --list-langs 2>/dev/null || true)"
  missing=""
  # OCR_LANGS is like deu+eng
  local IFS='+'
  for lang in $OCR_LANGS; do
    if ! printf '%s\n' "$installed" | grep -qx "$lang"; then
      missing="$missing $lang"
    fi
  done
  unset IFS
  if [ -n "$missing" ]; then
    die "tesseract is missing language pack(s):$missing. Install with: brew install tesseract-lang"
  fi

  # Image -> PDF assembler: prefer img2pdf (lossless, no re-encode), else ImageMagick.
  if command -v img2pdf >/dev/null 2>&1; then
    ASSEMBLER="img2pdf"
  elif command -v magick >/dev/null 2>&1; then
    ASSEMBLER="magick"
    warn "img2pdf not found; falling back to ImageMagick 'magick' for page assembly."
  else
    die "No image-to-PDF assembler found. Install one with: brew install img2pdf"
  fi

  mkdir -p "$OUT_DIR"
  mkdir -p "$STAGING"
  STAGING_READY=1
}

# ---------------------------------------------------------------------------
# Cleanup trap — ALWAYS runs
# ---------------------------------------------------------------------------
cleanup() {
  # Preserve the exit code of whatever triggered us unless EXIT_CODE was set.
  local rc=$?
  trap - EXIT INT TERM

  # Stop the daemon's whole process group so no node stays bound to the port.
  if [ -n "$DAEMON_PGID" ]; then
    if kill -0 "-$DAEMON_PGID" 2>/dev/null; then
      kill -TERM "-$DAEMON_PGID" 2>/dev/null || true
      local i=0
      while [ "$i" -lt 20 ] && kill -0 "-$DAEMON_PGID" 2>/dev/null; do
        sleep 0.25
        i=$((i + 1))
      done
      if kill -0 "-$DAEMON_PGID" 2>/dev/null; then
        kill -KILL "-$DAEMON_PGID" 2>/dev/null || true
      fi
    fi
    DAEMON_PGID=""
  fi

  if [ "$RUN_STATUS" = "failed" ]; then
    # Leave raw pages recoverable and keep the daemon log for diagnosis.
    if [ -n "$STAGING" ] && [ -d "$STAGING" ]; then
      err "Run failed. Raw pages were KEPT for recovery in: $STAGING"
      if [ -n "$DAEMON_LOG" ] && [ -f "$DAEMON_LOG" ]; then
        err "Daemon log kept at: $DAEMON_LOG"
      fi
    fi
  else
    # ok or aborted: remove this batch's temp files + staged raw pages.
    [ -n "$MERGED_TMP" ] && [ -f "$MERGED_TMP" ] && rm -f "$MERGED_TMP" 2>/dev/null || true
    [ -n "$SIDECAR_TMP" ] && [ -f "$SIDECAR_TMP" ] && rm -f "$SIDECAR_TMP" 2>/dev/null || true
    if [ "$STAGING_READY" = "1" ] && [ -n "$STAGING" ] && [ -d "$STAGING" ]; then
      # Only remove scan pages + our temp artifacts; never reach into OUT_DIR root.
      rm -f "$STAGING"/scan_*.jpg "$STAGING"/scan_*.jpeg "$STAGING"/scan_*.pdf 2>/dev/null || true
      [ -n "$DAEMON_LOG" ] && [ -f "$DAEMON_LOG" ] && rm -f "$DAEMON_LOG" 2>/dev/null || true
      rm -f "$STAGING"/merged_*.pdf "$STAGING"/*.ocr.txt 2>/dev/null || true
      # Remove the hidden staging dir if now empty.
      rmdir "$STAGING" 2>/dev/null || true
    fi
  fi

  if [ "$EXIT_CODE" != "" ] && [ "$RUN_STATUS" != "ok" ]; then
    exit "$EXIT_CODE"
  fi
  exit "$rc"
}

# ---------------------------------------------------------------------------
# Epson helper apps + daemon lifecycle
# ---------------------------------------------------------------------------
quit_helper_apps() {
  local app pat quit_any=0
  for app in "Epson ScanSmart" "Epson Scanner Monitor" "Epson Event Manager"; do
    if osascript -e "application \"$app\" is running" 2>/dev/null | grep -qi true; then
      osascript -e "quit app \"$app\"" 2>/dev/null || true
      log "Quit helper app: $app"
      quit_any=1
    fi
  done
  for pat in "ScanSmart" "Scanner Monitor" "Event Manager"; do
    if pkill -f "$pat" 2>/dev/null; then
      log "Killed lingering process matching: $pat"
      quit_any=1
    fi
  done
  if [ "$quit_any" = "0" ]; then
    log "No Epson helper apps were running."
  fi
}

port_in_use() {
  lsof -nP -iTCP:"$SCAN_PORT" -sTCP:LISTEN 2>/dev/null | grep -q LISTEN
}

check_port_free() {
  if port_in_use; then
    err "Port $SCAN_PORT is already in use — the daemon cannot start."
    err "This is usually an Epson helper app (ScanSmart / Scanner Monitor / Event Manager) or a stale daemon."
    err "Find it:   lsof -nP -iTCP:$SCAN_PORT -sTCP:LISTEN"
    err "Kill it:   kill \$(lsof -nP -tiTCP:$SCAN_PORT -sTCP:LISTEN)"
    lsof -nP -iTCP:"$SCAN_PORT" -sTCP:LISTEN 2>/dev/null >&2 || true
    RUN_STATUS="aborted"
    EXIT_CODE=2
    exit 2
  fi
}

start_daemon() {
  [ -d "$E2P_DIR" ] || die "epson2paperless path not found: $E2P_DIR (use --e2p)"
  [ -f "$E2P_DIR/package.json" ] || die "no package.json in epson2paperless path: $E2P_DIR"

  DAEMON_LOG="$STAGING/daemon.log"
  : > "$DAEMON_LOG"

  log "Starting epson2paperless daemon (printer $PRINTER_IP, output -> $STAGING)..."
  # Run in its own process group so cleanup can kill the whole npm->tsx->node tree.
  # setsid is unavailable on macOS; `set -m` makes the backgrounded pipeline a new
  # process group whose PGID equals the child PID.
  set -m
  (
    cd "$E2P_DIR" || exit 97
    exec env PRINTER_IP="$PRINTER_IP" OUTPUT_DIR="$STAGING" npm run dev
  ) >>"$DAEMON_LOG" 2>&1 &
  DAEMON_PGID=$!
  set +m

  # Wait for readiness by polling the daemon log.
  local waited=0
  while [ "$waited" -lt "$READY_TIMEOUT" ]; do
    if grep -q "epson2paperless ready" "$DAEMON_LOG" 2>/dev/null; then
      log "Daemon ready."
      return 0
    fi
    if ! kill -0 "-$DAEMON_PGID" 2>/dev/null && ! kill -0 "$DAEMON_PGID" 2>/dev/null; then
      err "Daemon process exited before becoming ready. Last log lines:"
      tail -n 20 "$DAEMON_LOG" >&2 || true
      RUN_STATUS="failed"
      EXIT_CODE=3
      exit 3
    fi
    sleep 1
    waited=$((waited + 1))
  done

  err "Daemon did not report ready within ${READY_TIMEOUT}s. Last log lines:"
  tail -n 20 "$DAEMON_LOG" >&2 || true
  err "Check the printer IP ($PRINTER_IP) and $DAEMON_LOG."
  RUN_STATUS="failed"
  EXIT_CODE=3
  exit 3
}

# ---------------------------------------------------------------------------
# Watch staging + wait for ENTER
# ---------------------------------------------------------------------------

# File size in bytes, portable-ish (BSD stat on macOS).
file_size() {
  stat -f '%z' "$1" 2>/dev/null || printf '%s' "-1"
}

already_seen() {
  # $1 = path. Return 0 if in STAGED_PAGES. (Grep-in-pipeline is fine as a
  # function's own return status; the no-match 1 propagates as the function's
  # exit code, which callers test explicitly — never as a bare pipefail abort.)
  printf '%s\n' "$STAGED_PAGES" | grep -qxF "$1"
}

# Globals set by watch_and_wait
PAGE_COUNT=0
# Pending files awaiting size-stability, recorded as newline-separated "path=size".
PENDING_SIZES_MAP=""

# Look up the last recorded pending size for a path (empty if none).
# Guard the grep: a no-match (status 1) under pipefail+errexit would otherwise
# abort the script, so swallow it with `|| true`.
pending_size_of() {
  printf '%s\n' "$PENDING_SIZES_MAP" | { grep -F "$1=" || true; } | tail -1 | sed 's/^.*=//'
}

# Remove a path's entry from the pending map.
pending_drop() {
  PENDING_SIZES_MAP="$(printf '%s\n' "$PENDING_SIZES_MAP" | grep -vF "$1=" || true)"
}

# Scan staging for new, size-stable pages and accept them. set -e safe: every
# command either cannot fail or is guarded (|| true / inside if).
scan_for_new_pages() {
  local f sz prev
  for f in "$STAGING"/scan_*.jpg "$STAGING"/scan_*.jpeg "$STAGING"/scan_*.pdf; do
    if [ ! -e "$f" ]; then
      continue
    fi
    if already_seen "$f"; then
      continue
    fi
    sz="$(file_size "$f")"
    prev="$(pending_size_of "$f")"
    if [ -n "$prev" ] && [ "$prev" = "$sz" ] && [ "$sz" != "-1" ] && [ "$sz" != "0" ]; then
      # Size stable across two consecutive polls -> accept the page.
      STAGED_PAGES="$STAGED_PAGES
$f"
      PAGE_COUNT=$((PAGE_COUNT + 1))
      pending_drop "$f"
      log "Page $PAGE_COUNT captured ($(basename "$f")). Press ENTER to finish, or keep scanning."
    else
      # Record / update the pending size for the next poll's comparison.
      pending_drop "$f"
      PENDING_SIZES_MAP="$PENDING_SIZES_MAP
$f=$sz"
    fi
  done
}

watch_and_wait() {
  log ""
  log "Ready — scan your pages from the printer panel (Scan → Computer → Paperless → Save as JPEG). Press ENTER when done, Ctrl-C to abort."
  # NOTE ON bash 3.2: a `read -t` TIMEOUT and an EOF both return exit status 1
  # on macOS system bash (only bash 4+ returns >128 on timeout). We therefore
  # cannot distinguish them by status. In every real scenario the right action
  # for a non-zero read is the same — keep watching — because:
  #   * interactive terminal: stdin stays open until the user presses ENTER
  #     (which yields status 0 and finishes), so non-zero == 1s timeout.
  #   * piped stdin that writes later (producer sleeps then prints ENTER): the
  #     early 1s timeouts return non-zero; the newline, once written, yields 0.
  # To avoid spinning forever on a genuinely closed/empty stdin, bound the wall
  # clock with a very large but finite cap and also break if stdin hits EOF and
  # stays non-readable for the cap. The cap is effectively "forever" for humans.
  local line rc
  while :; do
    scan_for_new_pages
    line=""
    set +e
    IFS= read -t 1 -r line
    rc=$?
    set -e
    if [ "$rc" -eq 0 ]; then
      break                 # a line arrived (ENTER) -> finish
    fi
    # non-zero: 1s timeout (bash 3.2) -> keep watching for more pages / ENTER
  done
}

# ---------------------------------------------------------------------------
# Finish: collect, name, assemble, OCR
# ---------------------------------------------------------------------------
sanitize_name() {
  # strip path separators and surrounding whitespace; ensure .pdf
  local n="$1"
  n="${n%$'\n'}"
  n="$(printf '%s' "$n" | tr -d '/\\' )"
  # trim leading/trailing whitespace
  n="$(printf '%s' "$n" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  printf '%s' "$n"
}

resolve_output_path() {
  # $1 = base name (already sanitized, may lack .pdf). Echo a non-colliding path.
  local base="$1" stem ext candidate i
  case "$base" in
    *.pdf) stem="${base%.pdf}" ;;
    *)     stem="$base" ;;
  esac
  candidate="$OUT_DIR/$stem.pdf"
  if [ ! -e "$candidate" ]; then
    printf '%s' "$candidate"
    return 0
  fi
  i=1
  while [ -e "$OUT_DIR/${stem}_$i.pdf" ]; do
    i=$((i + 1))
  done
  printf '%s' "$OUT_DIR/${stem}_$i.pdf"
}

assemble_pages() {
  # $1 = output merged pdf path; remaining args = page files in order
  local out="$1"; shift
  if [ "$ASSEMBLER" = "img2pdf" ]; then
    img2pdf --output "$out" "$@"
  else
    magick "$@" "$out"
  fi
}

finish_batch() {
  # Collect staged pages (the ones we accepted), sorted lexically = scan order.
  local pages_sorted
  pages_sorted="$(printf '%s\n' "$STAGED_PAGES" | sed '/^$/d' | sort)"

  if [ -z "$pages_sorted" ]; then
    log "No pages scanned — nothing to do."
    RUN_STATUS="ok"
    EXIT_CODE=0
    exit 0
  fi

  # Build an indexed array of page paths.
  local pages=()
  local p
  while IFS= read -r p; do
    if [ -n "$p" ]; then
      pages+=("$p")
    fi
  done <<EOF
$pages_sorted
EOF

  local n="${#pages[@]}"

  # Prompt for a name.
  local default_name reply name
  default_name="scan_$(date +%Y-%m-%d_%H%M%S)"
  printf 'Name for this document (ENTER for timestamp default): '
  if IFS= read -r reply; then :; else reply=""; fi
  name="$(sanitize_name "$reply")"
  if [ -z "$name" ]; then
    name="$default_name"
  fi

  local out_path
  out_path="$(resolve_output_path "$name")"

  MERGED_TMP="$STAGING/merged_$$.pdf"
  log "Assembling $n page(s) into a PDF ($ASSEMBLER)..."
  if ! assemble_pages "$MERGED_TMP" "${pages[@]}"; then
    err "Failed to assemble pages into a PDF."
    RUN_STATUS="failed"
    EXIT_CODE=4
    exit 4
  fi

  log "Running OCR (ocrmypdf -l $OCR_LANGS) — this makes the PDF searchable..."
  if ! ocrmypdf -l "$OCR_LANGS" "$MERGED_TMP" "$out_path"; then
    err "ocrmypdf failed."
    RUN_STATUS="failed"
    EXIT_CODE=5
    exit 5
  fi

  rm -f "$MERGED_TMP" 2>/dev/null || true
  MERGED_TMP=""

  log ""
  log "Done. Searchable PDF ($n page(s)) written to:"
  log "  $out_path"
  RUN_STATUS="ok"
  EXIT_CODE=0
}

# ---------------------------------------------------------------------------
# Self-test (offline; no daemon, no scanner)
# ---------------------------------------------------------------------------
make_test_jpeg() {
  # $1 = path, $2 = label text
  if command -v magick >/dev/null 2>&1; then
    magick -size 850x1100 xc:white -gravity center -pointsize 72 \
      -annotate 0 "$2" "$1" >/dev/null 2>&1
  elif command -v sips >/dev/null 2>&1; then
    # sips cannot draw text, so convert the first available system picture into
    # a JPEG. This is only a safety net; the primary path uses ImageMagick,
    # which draws real text for OCR. For this path the self-test relaxes the
    # text-content assertion to "a text stream exists".
    local src
    for src in /System/Library/Desktop\ Pictures/*.heic \
               /System/Library/CoreServices/DefaultDesktop.heic \
               /Library/Desktop\ Pictures/*.jpg; do
      [ -e "$src" ] || continue
      sips -s format jpeg -z 1100 850 "$src" --out "$1" >/dev/null 2>&1 || true
      break
    done
  fi
}

self_test() {
  # The self-test is a harness: it must run every assertion and tally results
  # itself, so disable errexit for its body (it manages its own exit code).
  set +e
  local tmproot td
  td="$(mktemp -d "${TMPDIR:-/tmp}/scanbatch-selftest.XXXXXX")"
  OUT_DIR="$td/out"
  STAGING="$td/out/.work"
  local overall=0

  log "=== scan-batch self-test ==="
  log "Temp OUT_DIR: $OUT_DIR"
  preflight

  # --- Positive case: 3 text JPEGs -> searchable 3-page PDF ---
  log ""
  log "[1/3] Positive: assemble 3 JPEGs -> OCR searchable PDF"
  make_test_jpeg "$STAGING/scan_2026-01-01_000001.jpg" "Alpha"
  make_test_jpeg "$STAGING/scan_2026-01-01_000002.jpg" "Bravo"
  make_test_jpeg "$STAGING/scan_2026-01-01_000003.jpg" "Charlie"
  if [ ! -f "$STAGING/scan_2026-01-01_000001.jpg" ]; then
    err "Could not generate test JPEGs (need ImageMagick or sips)."
    RUN_STATUS="failed"; EXIT_CODE=10; exit 10
  fi

  # Register the pages as if the watcher accepted them.
  STAGED_PAGES="$STAGING/scan_2026-01-01_000001.jpg
$STAGING/scan_2026-01-01_000002.jpg
$STAGING/scan_2026-01-01_000003.jpg"

  # Drive finish_batch non-interactively with a preset name via a subshell so a
  # failing exit does not abort the whole self-test.
  local out_pdf="$OUT_DIR/selftest-doc.pdf"
  (
    # feed the document name on stdin
    printf 'selftest-doc\n' | {
      # inline a trimmed finish for determinism: reuse real functions
      pages_sorted="$(printf '%s\n' "$STAGED_PAGES" | sort)"
      pages=()
      while IFS= read -r p; do [ -n "$p" ] && pages+=("$p"); done <<INNER
$pages_sorted
INNER
      MERGED_TMP="$STAGING/merged_$$.pdf"
      assemble_pages "$MERGED_TMP" "${pages[@]}" || exit 20
      ocrmypdf -l "$OCR_LANGS" "$MERGED_TMP" "$out_pdf" || exit 21
      rm -f "$MERGED_TMP"
    }
  ) || { err "positive assemble/OCR failed"; overall=1; }

  # Assertions
  if [ -f "$out_pdf" ]; then
    local npages
    npages="$(pdfinfo "$out_pdf" 2>/dev/null | awk '/^Pages:/{print $2}')"
    if [ "$npages" = "3" ]; then
      log "  OK: page count == 3"
    else
      err "  FAIL: expected 3 pages, got '${npages:-?}'"; overall=1
    fi
    if command -v magick >/dev/null 2>&1; then
      if pdftotext "$out_pdf" - 2>/dev/null | grep -qiE 'Alpha|Bravo|Charlie'; then
        log "  OK: text layer present (searchable)"
      else
        err "  FAIL: no expected text found in OCR layer"; overall=1
      fi
    else
      # sips path produced no drawable text; just confirm a text stream exists
      if pdffonts "$out_pdf" >/dev/null 2>&1 || pdftotext "$out_pdf" - >/dev/null 2>&1; then
        log "  OK: PDF has a text stream (sips path; text content not asserted)"
      else
        err "  FAIL: no text layer at all"; overall=1
      fi
    fi
  else
    err "  FAIL: output PDF not created at $out_pdf"; overall=1
  fi

  # --- Cleanup assertions: simulate success cleanup ---
  log ""
  log "[2/3] Cleanup: success removes staged pages + daemon.log, keeps finished PDF"
  : > "$STAGING/daemon.log"; DAEMON_LOG="$STAGING/daemon.log"
  # emulate the success branch of cleanup inline (so we don't exit)
  rm -f "$STAGING"/scan_*.jpg "$STAGING"/scan_*.jpeg "$STAGING"/scan_*.pdf 2>/dev/null || true
  rm -f "$DAEMON_LOG" 2>/dev/null || true
  rm -f "$STAGING"/merged_*.pdf 2>/dev/null || true
  local leftover
  leftover="$(ls -1 "$STAGING"/scan_*.jpg 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$leftover" = "0" ] && [ ! -f "$DAEMON_LOG" ]; then
    log "  OK: staging cleaned, daemon.log removed"
  else
    err "  FAIL: staging not clean (leftover=$leftover) or daemon.log present"; overall=1
  fi
  if [ -f "$out_pdf" ]; then
    log "  OK: finished PDF untouched by cleanup"
  else
    err "  FAIL: finished PDF was removed by cleanup"; overall=1
  fi

  # --- Negative case: ocrmypdf failure keeps staging ---
  log ""
  log "[3/3] Negative: OCR failure must RETAIN raw pages"
  printf 'not a real image' > "$STAGING/scan_2026-01-01_000009.jpg"
  local bad_merged="$STAGING/merged_bad.pdf"
  local failed_as_expected=0
  if assemble_pages "$bad_merged" "$STAGING/scan_2026-01-01_000009.jpg" >/dev/null 2>&1; then
    # assembler accepted it (unlikely for corrupt jpg); try OCR
    if ! ocrmypdf -l "$OCR_LANGS" "$bad_merged" "$OUT_DIR/should-not-exist.pdf" >/dev/null 2>&1; then
      failed_as_expected=1
    fi
  else
    failed_as_expected=1
  fi
  if [ "$failed_as_expected" = "1" ] && [ -f "$STAGING/scan_2026-01-01_000009.jpg" ]; then
    log "  OK: failure path left raw page in staging ($STAGING)"
  else
    err "  FAIL: failure path did not behave as expected"; overall=1
  fi
  rm -f "$bad_merged" "$OUT_DIR/should-not-exist.pdf" 2>/dev/null || true

  # --- Port check sanity (non-fatal): confirm detector works ---
  log ""
  if port_in_use; then
    log "note: port $SCAN_PORT currently in use on this host (detector works)."
  else
    log "note: port $SCAN_PORT free (detector works)."
  fi

  # --- Orphan check: no node bound to the scan port that we started ---
  if [ -z "$DAEMON_PGID" ]; then
    log "  OK: self-test started no daemon (no orphan possible)."
  fi

  # Clean up temp root entirely.
  rm -rf "$td" 2>/dev/null || true

  log ""
  if [ "$overall" = "0" ]; then
    log "=== SELF-TEST PASS ==="
    RUN_STATUS="ok"; EXIT_CODE=0
    # bypass the normal cleanup's staging logic (already removed temp root)
    STAGING_READY=0; STAGING=""
    exit 0
  else
    log "=== SELF-TEST FAIL ==="
    RUN_STATUS="failed"; EXIT_CODE=11
    STAGING_READY=0; STAGING=""
    exit 11
  fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  parse_args "$@"
  trap cleanup EXIT INT TERM

  if [ "$SELF_TEST" = "1" ]; then
    self_test
    return
  fi

  preflight

  if [ "$NO_DAEMON" = "0" ]; then
    quit_helper_apps
    check_port_free
    start_daemon
  else
    log "(--no-daemon) Skipping helper-app quit and daemon startup; watching $STAGING."
  fi

  watch_and_wait
  finish_batch
}

main "$@"
