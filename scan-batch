                        the pages then OCR with 'ocrmypdf --optimize 3' (JBIG2
                        bitonal text mask via jbig2enc + pngquant color), which
                        needs NO recode_pdf. Implies --mrc. Still a SEARCHABLE,
                        smaller color PDF; degrades with a warning (not an error)
                        if jbig2enc/pngquant are absent.

  Fallback behavior: --mrc normally uses recode_pdf when it is installed. If
  recode_pdf is NOT installed, OR a recode_pdf run fails / produces no text
  layer, scan-batch does NOT error out — it AUTOMATICALLY uses the ocrmypdf
  --optimize 3 fallback above (still searchable) and notes it in the log. Use
  --mrc-fallback to force that path even when recode_pdf is present.

MODES
  --self-test           Run the offline self-test (no daemon, no scanner) and exit.
  --no-daemon           Skip helper-app quit + daemon startup (file-based mode).
  --version             Print tool name, version, git commit, Node version; exit.
  -h, --help            Show this help and exit.

FLOW
  Run it, scan each page as JPEG from the printer panel
  (Scan -> Computer -> Paperless -> Save as JPEG), press ENTER when done, then
  name the document. Pages merge in scan order into one searchable PDF.

EXIT CODES
  0 success · 2 port busy · 3 daemon not ready · 4 assemble failed ·
  5 ocr failed · 130 interrupted (SIGINT) · 143 terminated (SIGTERM).
  On interrupt the captured raw pages are PRESERVED (not deleted).`);
}

// ---------------------------------------------------------------------------
// Version string: tool name + version (package.json next to the script, else
// the literal "2.1") + git short commit (resolved in the script's own dir, or
// "unknown" if git is absent / not a repo) + the Node version. Needs no
// external scanner/ocr tools so --version works on a bare machine.
// ---------------------------------------------------------------------------
function versionString() {
  const scriptDir = path.dirname(fs.realpathSync(__filename));
  let version = "2.1";
  try {
    const pkg = JSON.parse(fs.readFileSync(path.join(scriptDir, "package.json"), "utf8"));
    if (pkg && pkg.version) version = String(pkg.version);
  } catch { /* no package.json / unreadable — keep the fallback */ }

  let commit = "unknown";
  if (have("git")) {
    const r = run("git", ["rev-parse", "--short", "HEAD"], { cwd: scriptDir });
    if (r.status === 0 && r.stdout) {
      const s = r.stdout.trim();
      if (s) commit = s;
    }
  }
  return `scan-batch ${version} (${commit}) node ${process.version}`;
}

// ---------------------------------------------------------------------------
// Arg parsing + precedence (flags override env override defaults)
// ---------------------------------------------------------------------------
function expandTilde(p) {
  if (p === "~") return HOME;
  if (p.startsWith("~/")) return path.join(HOME, p.slice(2));
  return p;
}

function wantValue(args, i, flag) {
  if (i + 1 >= args.length) throw new ExitError(1, `${flag} needs a value`);
  return args[i + 1];
}

function parseIntStrict(v, flag) {
  if (!/^-?\d+$/.test(v)) throw new ExitError(1, `${flag} needs an integer, got '${v}'`);
  return parseInt(v, 10);
}

function parseArgs(argv) {
  const args = argv.slice();
  let positionalOut = "";
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    switch (a) {
      case "--out":
        cfg.outDir = expandTilde(wantValue(args, i, a)); i++; break;
      case "--staging":
        cfg.staging = expandTilde(wantValue(args, i, a)); i++; break;
      case "--printer-ip":
        cfg.printerIp = wantValue(args, i, a); i++; break;
      case "--e2p":
        cfg.e2pDir = expandTilde(wantValue(args, i, a)); i++; break;
      case "--langs":
        cfg.ocrLangs = wantValue(args, i, a); i++; break;
      case "--quality": {
        const q = parseIntStrict(wantValue(args, i, a), a); i++;
        if (q < 1 || q > 100) throw new ExitError(1, "--quality must be 1-100");
        cfg.quality = q; cfg.fullQuality = false; break;
      }
      case "--full-quality":
        cfg.fullQuality = true; break;
      case "--optimize": {
        const o = parseIntStrict(wantValue(args, i, a), a); i++;
        if (o < 0 || o > 3) throw new ExitError(1, "--optimize must be 0-3");
        cfg.optimize = o; break;
      }
      case "--dpi": {
        const d = parseIntStrict(wantValue(args, i, a), a); i++;
        if (d <= 0) throw new ExitError(1, "--dpi must be a positive integer");
        cfg.dpi = d; break;
      }
      case "--grayscale":
        cfg.grayscale = true; break;
      case "--color-mode": {
        const m = wantValue(args, i, a).toLowerCase(); i++;
        if (m === "gray" || m === "grayscale") cfg.grayscale = true;
        else if (m === "color" || m === "colour") cfg.grayscale = false;
        else throw new ExitError(1, `--color-mode must be gray|color, got '${m}'`);
        break;
      }
      case "--keep-staging":
        cfg.keepStaging = true; break;
      case "--mrc":
        cfg.mrc = true; break;
      case "--mrc-bg-downsample": {
        const n = parseIntStrict(wantValue(args, i, a), a); i++;
        if (n < 1) throw new ExitError(1, "--mrc-bg-downsample must be >= 1");
        cfg.mrcBgDownsample = n; break;
      }
      case "--mrc-fallback":
        // Forcing the fallback implies the MRC pipeline (so --mrc is optional
        // alongside it) and produces a smaller, searchable PDF without recode_pdf.
        cfg.mrc = true; cfg.mrcFallback = true; break;
      case "--version":
        log(versionString()); throw new ExitError(0);
      case "--self-test":
        cfg.selfTest = true; cfg.noDaemon = true; break;
      case "--no-daemon":
        cfg.noDaemon = true; break;
      case "-h":
      case "--help":
        usage(); throw new ExitError(0);
      case "--":
        // Remaining args are positional; take first as OUTPUT_DIR.
        if (i + 1 < args.length && !positionalOut) positionalOut = args[i + 1];
        i = args.length; break;
      default:
        if (a.startsWith("-")) throw new ExitError(1, `unknown option: ${a} (see --help)`);
        if (!positionalOut) positionalOut = a;
        else throw new ExitError(1, `unexpected argument: ${a}`);
    }
  }
  if (positionalOut) cfg.outDir = expandTilde(positionalOut);
  if (!cfg.staging) cfg.staging = path.join(cfg.outDir, ".work");

  // --mrc and --full-quality are contradictory: MRC deliberately recompresses
  // the background (lossy, downsampled) to shrink the file, which is the exact
  // opposite of --full-quality's "preserve the raw scanner JPEG" promise.
  if (cfg.mrc && cfg.fullQuality) {
    throw new ExitError(1, "--mrc and --full-quality are contradictory (MRC recompresses to shrink; " +
      "full-quality preserves the raw JPEG). Pick one.");
  }

  if (cfg.dpi != null && !ADVERTISED_DPI.includes(cfg.dpi)) {
    warn(`--dpi ${cfg.dpi} is not an ET-3700 advertised value (${ADVERTISED_DPI.join("/")}); ` +
      "passing through, but the scanner may ignore it.");
  }
}

// ---------------------------------------------------------------------------
// Tool detection helpers
// ---------------------------------------------------------------------------
function have(tool) {
  // Resolve against PATH without invoking a shell (avoids DEP0190).
  const dirs = (process.env.PATH || "").split(path.delimiter);
  for (const d of dirs) {
    if (!d) continue;
    const p = path.join(d, tool);
    try {
      fs.accessSync(p, fs.constants.X_OK);
      return true;
    } catch { /* keep looking */ }
  }
  return false;
}

function run(cmd, cmdArgs, opts = {}) {
  // Synchronous external command; returns {status, stdout, stderr}.
  const r = spawnSync(cmd, cmdArgs, { encoding: "utf8", ...opts });
  return r;
}

// Locate recode_pdf (archive-pdf-tools) for the --mrc path. Checks, in order:
//   (1) $SCAN_BATCH_RECODE_PDF (explicit override),
//   (2) the dedicated venv at ~/.local/share/scan-batch-mrc/venv/bin/recode_pdf,
//   (3) recode_pdf anywhere on PATH.
// Returns the first existing path (or "recode_pdf" for the PATH case), else "".
// All paths derive from os.homedir() — never a hardcoded /Users path.
function findRecodePdf() {
  const envPath = process.env.SCAN_BATCH_RECODE_PDF;
  if (envPath) {
    try { fs.accessSync(envPath, fs.constants.X_OK); return envPath; } catch { /* fall through */ }
  }
  const venvPath = path.join(HOME, ".local", "share", "scan-batch-mrc", "venv", "bin", "recode_pdf");
  try { fs.accessSync(venvPath, fs.constants.X_OK); return venvPath; } catch { /* fall through */ }
  if (have("recode_pdf")) return "recode_pdf";
  return "";
}

// The copy-paste install block printed when --mrc is requested but recode_pdf
// is missing. Built at runtime from os.homedir() so it never embeds a literal
// /Users path. Mirrors the verified command set in the task context.
function mrcInstallHelp() {
  const venvDir = path.join(HOME, ".local", "share", "scan-batch-mrc", "venv");
  const recode = path.join(venvDir, "bin", "recode_pdf");
  return [
    "--mrc needs archive-pdf-tools' recode_pdf, which is not installed.",
    "Install it into a dedicated Python 3.13 virtualenv (one-time):",
    "",
    `  python3.13 -m venv "${venvDir}"`,
    `  "${path.join(venvDir, "bin", "pip")}" install --upgrade pip wheel`,
    `  "${path.join(venvDir, "bin", "pip")}" install archive-pdf-tools`,
    "",
    `recode_pdf will then live at: ${recode}`,
    "(or set SCAN_BATCH_RECODE_PDF to an existing recode_pdf, or put it on PATH).",
  ].join("\n");
}

// ---------------------------------------------------------------------------
// Preflight / dependency detection
// ---------------------------------------------------------------------------
function preflight() {
  if (!have("ocrmypdf")) throw new ExitError(1, "ocrmypdf not found. Install with: brew install ocrmypdf");
  if (!have("tesseract")) throw new ExitError(1, "tesseract not found. Install with: brew install tesseract tesseract-lang");

  // Verify requested OCR languages are installed.
  const listed = run("tesseract", ["--list-langs"]);
  const installed = (listed.stdout || "").split(/\r?\n/).map((s) => s.trim());
  const missing = cfg.ocrLangs.split("+").filter((l) => l && !installed.includes(l));
  if (missing.length) {
    throw new ExitError(1, `tesseract is missing language pack(s): ${missing.join(" ")}. ` +
      "Install with: brew install tesseract-lang");
  }

  // Image -> PDF assembler: prefer img2pdf (lossless), else ImageMagick.
  if (have("img2pdf")) {
    state.assembler = "img2pdf";
  } else if (have("magick")) {
    state.assembler = "magick";
    warn("img2pdf not found; falling back to ImageMagick 'magick' for page assembly.");
  } else {
    throw new ExitError(1, "No image-to-PDF assembler found. Install one with: brew install img2pdf");
  }

  // Re-encoder for --quality / --grayscale: prefer magick, else sips.
  if (have("magick")) state.reencoder = "magick";
  else if (have("sips")) state.reencoder = "sips";
  else state.reencoder = "";

  // Optional optimizers for ocrmypdf --optimize 2/3.
  state.hasJbig2 = have("jbig2");
  state.hasPngquant = have("pngquant");

  // MRC tooling detection (used whether or not --mrc is set, so the self-test
  // can decide to run or SKIP the MRC smoke).
  state.recodePdf = findRecodePdf();
  state.hasOpenjpeg = have("opj_compress") && have("opj_decompress");

  // When --mrc is requested, decide between the recode_pdf path and the
  // guaranteed-installable ocrmypdf --optimize 3 fallback (FEAT-003). The
  // fallback needs NO recode_pdf — only ocrmypdf (already required above) plus,
  // for best size, jbig2enc + pngquant (which degrade gracefully). So MRC never
  // hard-fails on a missing recode_pdf: if recode_pdf is absent (or the user
  // forced --mrc-fallback), we route to the fallback with a one-line notice.
  if (cfg.mrc) {
    const useFallback = cfg.mrcFallback || !state.recodePdf;
    if (useFallback) {
      if (cfg.mrcFallback) {
        log("--mrc-fallback: using the ocrmypdf --optimize 3 MRC fallback " +
          "(still searchable; needs no recode_pdf).");
      } else {
        // recode_pdf absent but --mrc requested: auto-use the fallback, and
        // point the user at the better-compressing recode_pdf install (optional).
        warn("recode_pdf not found; using the ocrmypdf --optimize 3 MRC fallback " +
          "(still searchable; install archive-pdf-tools for best size — see --help).");
      }
      // The fallback's heavy lifting is ocrmypdf --optimize 3: jbig2enc for the
      // bitonal text mask + pngquant for color. Missing either only degrades the
      // optimize level (see effectiveMrcFallbackOptimize), never errors.
      if (!state.hasJbig2 || !state.hasPngquant) {
        const miss = [!state.hasJbig2 ? "jbig2enc" : null, !state.hasPngquant ? "pngquant" : null]
          .filter(Boolean).join(" + ");
        warn(`MRC fallback size is best with jbig2enc + pngquant; ${miss} missing. ` +
          "The PDF is still searchable but larger. Install with: brew install jbig2enc pngquant");
      }
    } else {
      // recode_pdf path. jbig2 (jbig2enc) is required for the bitonal text mask;
      // the JP2 background needs an OpenJPEG CLI (or jpegoptim on the JPEG path).
      // These are preconditions for ATTEMPTING recode_pdf; if the run still fails
      // or yields no text, finishBatch auto-falls back (FALLBACK_FAILURE_POLICY).
      if (!state.hasJbig2) {
        throw new ExitError(1, "--mrc needs the jbig2 encoder for the bitonal text mask. " +
          "Install with: brew install jbig2enc  (or use --mrc-fallback, which needs no recode_pdf).");
      }
      if (!state.hasOpenjpeg && !have("jpegoptim")) {
        warn("--mrc background compression needs an OpenJPEG CLI (opj_compress/opj_decompress) " +
          "or jpegoptim; neither was found. Install one with: brew install openjpeg  (or: brew install jpegoptim). " +
          "If recode_pdf fails, scan-batch auto-uses the ocrmypdf --optimize 3 fallback.");
      }
    }
  }

  fs.mkdirSync(cfg.outDir, { recursive: true });
  fs.mkdirSync(cfg.staging, { recursive: true });
  state.stagingReady = true;
}

// ---------------------------------------------------------------------------
// Name sanitizing + non-colliding output path
// ---------------------------------------------------------------------------
function sanitizeName(raw) {
  let n = String(raw || "").replace(/[\r\n]+$/g, "");
  n = n.replace(/[/\\]/g, "");
  n = n.trim();
  return n;
}

function resolveOutputPath(base) {
  const stem = base.toLowerCase().endsWith(".pdf") ? base.slice(0, -4) : base;
  let candidate = path.join(cfg.outDir, `${stem}.pdf`);
  if (!fs.existsSync(candidate)) return candidate;
  let i = 1;
  while (fs.existsSync(path.join(cfg.outDir, `${stem}_${i}.pdf`))) i++;
  return path.join(cfg.outDir, `${stem}_${i}.pdf`);
}

function timestampName() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, "0");
  return `scan_${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}_` +
    `${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;
}

// ---------------------------------------------------------------------------
// Finish / assemble / OCR — the ONE path used by BOTH real runs and self-test
// ---------------------------------------------------------------------------

// Classify a page by extension (daemon emits .jpg/.jpeg or .pdf).
function pageKind(p) {
  const ext = path.extname(p).toLowerCase();
  if (ext === ".jpg" || ext === ".jpeg") return "image";
  if (ext === ".pdf") return "pdf";
  return "other";
}

// Re-encode / grayscale a single JPEG into destDir, returning the new path.
// Honors cfg.fullQuality (skip), cfg.grayscale, cfg.quality. Uses magick or sips.
function processImage(src, destDir, index) {
  const dst = path.join(destDir, `page_${String(index).padStart(4, "0")}.jpg`);
  if (cfg.fullQuality && !cfg.grayscale) {
    // Pure passthrough: copy the raw scanner JPEG untouched.
    fs.copyFileSync(src, dst);
    return dst;
  }
  if (state.reencoder === "magick") {
    const a = [src];
    if (cfg.grayscale) a.push("-colorspace", "Gray");
    if (!cfg.fullQuality) a.push("-quality", String(cfg.quality));
    a.push(dst);
    const r = run("magick", a);
    if (r.status !== 0) throw new ExitError(4, `magick re-encode failed: ${(r.stderr || "").trim()}`);
    return dst;
  }
  if (state.reencoder === "sips") {
    fs.copyFileSync(src, dst);
    const a = ["-s", "format", "jpeg"];
    if (!cfg.fullQuality) a.push("-s", "formatOptions", String(cfg.quality));
    if (cfg.grayscale) a.push("-m", "/System/Library/ColorSync/Profiles/Generic Gray Profile.icc");
    a.push(dst, "--out", dst);
    const r = run("sips", a);
    if (r.status !== 0) throw new ExitError(4, `sips re-encode failed: ${(r.stderr || "").trim()}`);
    return dst;
  }
  // No re-encoder available: fall back to passthrough copy.
  warn("No image re-encoder (magick/sips) found; shipping raw JPEG (size controls skipped).");
  fs.copyFileSync(src, dst);
  return dst;
}

// Rasterize ONE page of a PDF-format scan into a re-encoded JPEG in destDir,
// returning the new path. This is the PDF-route analogue of processImage: it
// applies cfg.quality (and cfg.grayscale) so PDF-format scanner pages are
// genuinely recompressed before the lossless img2pdf embeds them — the fix for
// the "q85 doesn't shrink real PDFs" bug. Requires ImageMagick (sips cannot
// rasterize a PDF); callers gate on state.reencoder === "magick".
//
// Density handling matters: `-density 300` BEFORE the input reproduces the
// page's pixel grid at 300 DPI (not a downsampled 96-DPI raster); the trailing
// `-units PixelsPerInch -density 300` re-tags the output JPEG at 300 PPI so the
// embedded image reports the correct resolution (without it magick writes a
// 96-PPI tag and the page mis-scales).
function processPdfPage(src, destDir, index) {
  const dst = path.join(destDir, `page_${String(index).padStart(4, "0")}.jpg`);
  const a = ["-density", "300", `${src}[0]`];
  if (cfg.grayscale) a.push("-colorspace", "Gray");
  a.push("-units", "PixelsPerInch", "-density", "300", "-quality", String(cfg.quality), dst);
  const r = run("magick", a);
  if (r.status !== 0) throw new ExitError(4, `magick PDF rasterize failed: ${(r.stderr || "").trim()}`);
  return dst;
}

function assembleImages(images, outPdf) {
  if (state.assembler === "img2pdf") {
    const r = run("img2pdf", ["--output", outPdf, ...images]);
    if (r.status !== 0) throw new ExitError(4, `img2pdf failed: ${(r.stderr || "").trim()}`);
  } else {
    const r = run("magick", [...images, outPdf]);
    if (r.status !== 0) throw new ExitError(4, `magick assembly failed: ${(r.stderr || "").trim()}`);
  }
}

function concatPdfs(pdfs, outPdf) {
  // qpdf cleanly concatenates single-page PDFs: qpdf --empty --pages a b -- out
  const r = run("qpdf", ["--empty", "--pages", ...pdfs, "--", outPdf]);
  if (r.status !== 0) {
    throw new ExitError(4,
      "Could not concatenate PDF-format scans with qpdf. Please re-scan as JPEG " +
      "(printer panel: Save as JPEG). Details: " + (r.stderr || "").trim());
  }
}

// Determine the effective ocrmypdf --optimize level given tool availability.
function effectiveOptimize() {
  let n = cfg.optimize;
  if (n >= 2 && !state.hasJbig2 && !state.hasPngquant) {
    warn("--optimize >=2 needs jbig2enc/pngquant (neither found); falling back to --optimize 1.");
    n = 1;
  } else if (n >= 2 && (!state.hasJbig2 || !state.hasPngquant)) {
    const miss = [!state.hasJbig2 ? "jbig2enc" : null, !state.hasPngquant ? "pngquant" : null]
      .filter(Boolean).join(", ");
    warn(`--optimize ${n}: ${miss} missing; ocrmypdf will apply what it can at this level.`);
  }
  return n;
}

// The effective ocrmypdf --optimize level for the MRC fallback. The fallback
// TARGETS --optimize 3 (the most aggressive lossless-image reduction: jbig2enc
// bitonal text mask + pngquant color quantization). If both optimizers are
// missing it degrades to --optimize 1 with a warning; if only one is missing it
// still requests 3 and lets ocrmypdf apply what it can — mirroring
// effectiveOptimize()'s graceful degradation, so the fallback never fails on a
// missing optimizer.
function effectiveMrcFallbackOptimize() {
  if (!state.hasJbig2 && !state.hasPngquant) {
    warn("MRC fallback: jbig2enc + pngquant both missing; dropping to --optimize 1 " +
      "(searchable, but larger). Install with: brew install jbig2enc pngquant");
    return 1;
  }
  return 3;
}

// Build the merged (pre-OCR) PDF from staged pages, applying size controls.
// Returns { mergedPdf, pageCount }.
function buildMergedPdf(pages, workDir) {
  const kinds = pages.map(pageKind);
  const allPdf = kinds.every((k) => k === "pdf");
  const anyPdf = kinds.some((k) => k === "pdf");
  const merged = path.join(workDir, `merged_${process.pid}.pdf`);

  if (allPdf) {
    // PDF-format input (the daemon's default SCAN_FORMAT=pdf deposits scan_*.pdf).
    if (cfg.fullQuality) {
      // Passthrough: concatenate single-page PDFs losslessly via qpdf, keeping
      // the scanner's original full-quality JPEG untouched. OCR runs with
      // --skip-text (fromPdf:true) so a page that already carries text can't
      // abort the run.
      concatPdfs(pages, merged);
      return { mergedPdf: merged, pageCount: pages.length, fromPdf: true };
    }
    if (state.reencoder === "magick") {
      // Size fix: rasterize each PDF page at cfg.quality so the page is genuinely
      // recompressed BEFORE the lossless img2pdf embeds it, then assemble as
      // images. The merged PDF now carries no pre-existing text layer, so the
      // downstream OCR runs normally (fromPdf:false, no --skip-text).
      const processed = [];
      pages.forEach((src, idx) => {
        processed.push(processPdfPage(src, workDir, idx + 1));
      });
      assembleImages(processed, merged);
      return { mergedPdf: merged, pageCount: pages.length, fromPdf: false };
    }
    // No ImageMagick (sips can't rasterize a PDF, or no re-encoder at all):
    // fall back to lossless qpdf concat so the batch still succeeds, and warn
    // that PDF-page size reduction needs ImageMagick.
    warn("PDF-format scans can only be size-reduced with ImageMagick " +
      "(brew install imagemagick); preserving pages at full quality via qpdf concat.");
    concatPdfs(pages, merged);
    return { mergedPdf: merged, pageCount: pages.length, fromPdf: true };
  }
  if (anyPdf) {
    // Mixed set: reject clearly rather than silently dropping pages.
    throw new ExitError(4,
      "Mixed JPEG and PDF scans in one batch are not supported. " +
      "Re-scan the whole batch in one format (Save as JPEG recommended).");
  }

  // All images: apply grayscale/quality per page, then assemble.
  const processed = [];
  pages.forEach((src, idx) => {
    processed.push(processImage(src, workDir, idx + 1));
  });
  assembleImages(processed, merged);
  return { mergedPdf: merged, pageCount: pages.length, fromPdf: false };
}

// ---------------------------------------------------------------------------
// MRC path (opt-in, --mrc): archive-pdf-tools recode_pdf.
//
// recode_pdf builds the MRC PDF (JBIG2 bitonal text mask + downsampled JPEG2000
// background) but does NOT OCR — searchability comes from a SINGLE multi-page
// hOCR we generate with tesseract and feed via --hocr-file, mapped positionally
// to the glob-sorted image stack. We name the stack page_0001.jpg.. so glob
// order == scan order.
//
// Precedence/composition (also surfaced in --help):
//   - --mrc SUPERSEDES --quality: we do NOT re-encode pages at cfg.quality here;
//     recode_pdf's background downsample (--mrc-bg-downsample) controls size.
//   - --mrc composes with --grayscale: pages are converted to gray AND
//     recode_pdf is told --grayscale-pdf.
//   - --optimize is IGNORED under --mrc (recode_pdf already outputs an optimized
//     MRC/PDFA; ocrmypdf never runs on this path).
//   - --mrc + --full-quality is rejected earlier in parseArgs().
// ---------------------------------------------------------------------------

// Prepare the recode_pdf image stack: one page_NNNN.jpg per input page, in scan
// order, grayscale-converted when requested but NOT down-quality re-encoded
// (recode_pdf governs final compression). Images are copied/grayscaled; PDF
// pages are rasterized at 300 DPI (requires magick). Returns the stack paths.
function buildMrcImageStack(pages, workDir) {
  const stack = [];
  pages.forEach((src, idx) => {
    const kind = pageKind(src);
    const dst = path.join(workDir, `page_${String(idx + 1).padStart(4, "0")}.jpg`);
    if (kind === "pdf") {
      if (state.reencoder !== "magick") {
        throw new ExitError(4, "--mrc on PDF-format scans needs ImageMagick to rasterize pages " +
          "(brew install imagemagick). Re-scan as JPEG, or drop --mrc.");
      }
      const a = ["-density", "300", `${src}[0]`];
      if (cfg.grayscale) a.push("-colorspace", "Gray");
      a.push("-units", "PixelsPerInch", "-density", "300", "-quality", "95", dst);
      const r = run("magick", a);
      if (r.status !== 0) throw new ExitError(4, `magick PDF rasterize (mrc) failed: ${(r.stderr || "").trim()}`);
    } else if (cfg.grayscale && state.reencoder === "magick") {
      const r = run("magick", [src, "-colorspace", "Gray", "-quality", "95", dst]);
      if (r.status !== 0) throw new ExitError(4, `magick grayscale (mrc) failed: ${(r.stderr || "").trim()}`);
    } else if (cfg.grayscale && state.reencoder === "sips") {
      fs.copyFileSync(src, dst);
      const r = run("sips", ["-m", "/System/Library/ColorSync/Profiles/Generic Gray Profile.icc", dst, "--out", dst]);
      if (r.status !== 0) throw new ExitError(4, `sips grayscale (mrc) failed: ${(r.stderr || "").trim()}`);
    } else {
      // Color (default) and no re-encode: use the raw scanner JPEG as-is so the
      // text mask is built from the sharpest available source.
      fs.copyFileSync(src, dst);
    }
    stack.push(dst);
  });
  return stack;
}

// Generate ONE multi-page hOCR covering the glob-sorted image stack: run
// tesseract's own `hocr` config per page, then concatenate the per-page bodies
// into a single hOCR document whose <div class="ocr_page"> order matches the
// stack. Using tesseract's native hOCR (not a third-party converter) avoids the
// glyph-height/merge issues reported in archive-pdf-tools IA #37/#63/#69.
function buildMrcHocr(stack, workDir) {
  const perPageBodies = [];
  let header = "";
  stack.forEach((img, idx) => {
    const base = path.join(workDir, `hocr_${String(idx + 1).padStart(4, "0")}`);
    const r = run("tesseract", [img, base, "-l", cfg.ocrLangs, "hocr"]);
    if (r.status !== 0) throw new ExitError(5, `tesseract hOCR failed on page ${idx + 1}: ${(r.stderr || "").trim()}`);
    const hocrFile = `${base}.hocr`;
    const txt = fs.readFileSync(hocrFile, "utf8");
    if (!header) {
      const hm = txt.match(/^([\s\S]*?)<body>/i);
      header = hm ? hm[1] : "";
    }
    const bm = txt.match(/<body>([\s\S]*?)<\/body>/i);
    perPageBodies.push(bm ? bm[1] : "");
  });
  if (!header) {
    header = '<?xml version="1.0" encoding="UTF-8"?>\n' +
      '<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" ' +
      '"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">\n' +
      '<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">\n' +
      '<head><meta charset="utf-8"/></head>\n';
  }
  const merged = `${header}<body>\n${perPageBodies.join("\n")}\n</body>\n</html>\n`;
  const mergedPath = path.join(workDir, `mrc_${process.pid}.hocr`);
  fs.writeFileSync(mergedPath, merged);
  return mergedPath;
}

// Build the final MRC PDF via recode_pdf. Throws ExitError(5) on recode failure
// or if the resulting PDF has no real text layer (the known hOCR-merge
// fragility guard — a missing text layer points the user at the non-MRC path).
function buildMrcPdf(pages, workDir, outPath) {
  const stack = buildMrcImageStack(pages, workDir);
  const hocr = buildMrcHocr(stack, workDir);
  const glob = path.join(workDir, "page_*.jpg");

  const args = [
    "--from-imagestack", glob,
    "--hocr-file", hocr,
    "--dpi", String(cfg.dpi || 300),
    "--mask-compression", "jbig2",
    "--mrc-image-format", "jpeg2000",
    "--jpeg2000-implementation", "openjpeg",
    "--bg-downsample", String(cfg.mrcBgDownsample),
    "-o", outPath,
  ];
  if (cfg.grayscale) args.push("--grayscale-pdf");

  const r = run(state.recodePdf, args, { stdio: ["ignore", "inherit", "inherit"] });
  if (r.status !== 0 || !fs.existsSync(outPath)) {
    throw new ExitError(5, "recode_pdf (MRC) failed. If this persists, retry without --mrc " +
      "to use the standard ocrmypdf path." + (r.stderr ? ` Details: ${String(r.stderr).trim()}` : ""));
  }

  // Searchability guarantee: the MRC PDF MUST carry a real text layer. recode_pdf
  // can silently drop the hOCR layer (IA #37/#63/#69), so verify with pdftotext.
  const t = run("pdftotext", [outPath, "-"]);
  if (t.status !== 0 || !(t.stdout || "").trim()) {
    throw new ExitError(5, "MRC PDF has no searchable text layer (recode_pdf did not embed the hOCR). " +
      "Retry without --mrc to use the standard ocrmypdf path, which guarantees searchability.");
  }
  return { outPath, pageCount: pages.length };
}

// ---------------------------------------------------------------------------
// MRC FALLBACK (FEAT-003): guaranteed-installable, needs NO recode_pdf.
//
// Assemble the per-page JPEGs (img2pdf, honoring --grayscale and a moderate
// MRC_FALLBACK_QUALITY pre-pass, plus an optional --mrc-bg-downsample 300->DPI
// background downsample) then run `ocrmypdf -l <langs> --optimize 3
// --jpeg-quality <q> --png-quality <q>`. ocrmypdf's --optimize 3 performs a
// real MRC-like reduction with the already-installed jbig2enc (bitonal text
// mask) + pngquant (color), and because ocrmypdf runs genuine OCR the output is
// ALWAYS searchable. This is the safety net for recode_pdf's hOCR-merge
// fragility and for machines where archive-pdf-tools cannot be installed.
//
// Precedence/composition (mirrors the recode_pdf --mrc path):
//   - SUPERSEDES --quality: the fallback uses its own MRC_FALLBACK_QUALITY cap +
//     --optimize 3, not cfg.quality.
//   - composes with --grayscale (pages converted to gray before assembly).
//   - --mrc-bg-downsample N (N>1) downsamples the raster by N before OCR for a
//     smaller/softer background, consistent with the recode_pdf --bg-downsample.
// Throws ExitError on assemble/OCR failure or (as a parity guard with the
// recode_pdf path) if pdftotext finds no text layer after the run.
// ---------------------------------------------------------------------------

// Prepare the fallback image stack: one page_NNNN.jpg per input page in scan
// order, grayscale-converted when requested, re-encoded at MRC_FALLBACK_QUALITY,
// and (when --mrc-bg-downsample > 1) resized to 1/N for a smaller background.
// PDF-format pages are rasterized at 300 DPI (requires magick). Returns paths.
function buildMrcFallbackStack(pages, workDir) {
  const ds = cfg.mrcBgDownsample > 1 ? cfg.mrcBgDownsample : 1;
  const resizePct = ds > 1 ? String(Math.round(100 / ds)) + "%" : null;
  const stack = [];
  pages.forEach((src, idx) => {
    const dst = path.join(workDir, `page_${String(idx + 1).padStart(4, "0")}.jpg`);
    const kind = pageKind(src);
    if (kind === "pdf") {
      if (state.reencoder !== "magick") {
        throw new ExitError(4, "--mrc fallback on PDF-format scans needs ImageMagick to rasterize " +
          "pages (brew install imagemagick). Re-scan as JPEG, or drop --mrc.");
      }
      const a = ["-density", "300", `${src}[0]`];
      if (cfg.grayscale) a.push("-colorspace", "Gray");
      if (resizePct) a.push("-resize", resizePct);
      a.push("-units", "PixelsPerInch", "-density", "300", "-quality", String(MRC_FALLBACK_QUALITY), dst);
      const r = run("magick", a);
      if (r.status !== 0) throw new ExitError(4, `magick PDF rasterize (mrc fallback) failed: ${(r.stderr || "").trim()}`);
    } else if (state.reencoder === "magick") {
      const a = [src];
      if (cfg.grayscale) a.push("-colorspace", "Gray");
      if (resizePct) a.push("-resize", resizePct);
      a.push("-quality", String(MRC_FALLBACK_QUALITY), dst);
      const r = run("magick", a);
      if (r.status !== 0) throw new ExitError(4, `magick re-encode (mrc fallback) failed: ${(r.stderr || "").trim()}`);
    } else if (state.reencoder === "sips") {
      // sips can re-encode/quality + grayscale, but cannot downsample by factor
      // cleanly here; honor quality + grayscale and skip the resize (documented).
      fs.copyFileSync(src, dst);
      const a = ["-s", "format", "jpeg", "-s", "formatOptions", String(MRC_FALLBACK_QUALITY)];
      if (cfg.grayscale) a.push("-m", "/System/Library/ColorSync/Profiles/Generic Gray Profile.icc");
      a.push(dst, "--out", dst);
      const r = run("sips", a);
      if (r.status !== 0) throw new ExitError(4, `sips re-encode (mrc fallback) failed: ${(r.stderr || "").trim()}`);
    } else {
      warn("No image re-encoder (magick/sips) for the MRC fallback; shipping raw JPEG.");
      fs.copyFileSync(src, dst);
    }
    stack.push(dst);
  });
  return stack;
}

// Build the final MRC-fallback PDF: img2pdf assemble -> ocrmypdf --optimize 3.
// Always searchable (ocrmypdf OCRs). Asserts a text layer with pdftotext for
// parity with the recode_pdf path's guard. Throws ExitError on failure.
function buildMrcFallbackPdf(pages, workDir, outPath) {
  const stack = buildMrcFallbackStack(pages, workDir);
  const merged = path.join(workDir, `mrcfb_merged_${process.pid}.pdf`);
  assembleImages(stack, merged);

  const optN = effectiveMrcFallbackOptimize();
  const ocrArgs = ["-l", cfg.ocrLangs, "--optimize", String(optN),
    "--jpeg-quality", String(MRC_FALLBACK_QUALITY), "--png-quality", String(MRC_FALLBACK_QUALITY),
    merged, outPath];
  const r = run("ocrmypdf", ocrArgs, { stdio: ["ignore", "inherit", "inherit"] });
  try { fs.rmSync(merged, { force: true }); } catch { /* ignore */ }
  if (r.status !== 0 || !fs.existsSync(outPath)) {
    throw new ExitError(5, "ocrmypdf (MRC fallback) failed." +
      (r.stderr ? ` Details: ${String(r.stderr).trim()}` : ""));
  }

  // Parity guard with the recode_pdf path: assert a real text layer. ocrmypdf
  // OCRs so this is intrinsic, but we verify to catch an empty-OCR edge case.
  const t = run("pdftotext", [outPath, "-"]);
  if (t.status !== 0 || !(t.stdout || "").trim()) {
    throw new ExitError(5, "MRC fallback PDF has no searchable text layer (unexpected — ocrmypdf OCRs). " +
      "Retry without --mrc to use the standard path.");
  }
  return { outPath, pageCount: pages.length };
}

// The single finish path. `interactive` controls whether we prompt on stdin.
async function finishBatch(pages, { interactive = true, presetName = null } = {}) {
  const sorted = pages.slice().sort();
  if (sorted.length === 0) {
    log("No pages scanned — nothing to do.");
    state.runStatus = "ok";
    state.finished = true;
    return { outPath: null, pageCount: 0 };
  }

  // Resolve a name.
  let name;
  if (presetName != null) {
    name = sanitizeName(presetName);
  } else if (interactive) {
    const reply = await promptLine("Name for this document (ENTER for timestamp default): ");
    name = sanitizeName(reply);
  } else {
    name = "";
  }
  if (!name) name = timestampName();

  const outPath = resolveOutputPath(name);

  // MRC path (opt-in): replaces the img2pdf+ocrmypdf path entirely. Two routes:
  //   (A) recode_pdf (best size): its own JBIG2 mask + JP2 background + embedded
  //       hOCR text layer. --optimize is ignored (recode_pdf outputs optimized).
  //   (B) ocrmypdf --optimize 3 fallback (FEAT-003): guaranteed-installable, no
  //       recode_pdf, always searchable.
  // Selection + FALLBACK_FAILURE_POLICY (see top-of-file constant): use the
  // fallback when forced (--mrc-fallback) or when recode_pdf is absent. When the
  // recode_pdf route is attempted but FAILS or yields no text layer, we do NOT
  // hard-fail — we AUTO-FALL BACK to buildMrcFallbackPdf and note it in the log.
  if (cfg.mrc) {
    const forceFallback = cfg.mrcFallback || !state.recodePdf;
    if (forceFallback) {
      log(`Assembling ${sorted.length} page(s) via MRC fallback (ocrmypdf --optimize 3: ` +
        `JBIG2 text mask + pngquant color${cfg.grayscale ? ", grayscale" : ""}` +
        `${cfg.mrcBgDownsample > 1 ? `, bg downsample ${cfg.mrcBgDownsample}` : ""})...`);
      buildMrcFallbackPdf(sorted, cfg.staging, outPath);
    } else {
      log(`Assembling ${sorted.length} page(s) via MRC (recode_pdf: JBIG2 mask + JP2 bg, ` +
        `downsample ${cfg.mrcBgDownsample}${cfg.grayscale ? ", grayscale" : ""})...`);
      try {
        buildMrcPdf(sorted, cfg.staging, outPath);
      } catch (e) {
        if (!(e instanceof ExitError)) throw e;
        // Auto-fallback: recode_pdf failed or produced no text layer. Clean any
        // partial output and rebuild with the guaranteed-searchable fallback.
        warn(`recode_pdf MRC failed (${e.message}). Falling back to the ocrmypdf ` +
          "--optimize 3 MRC path (still searchable).");
        try { fs.rmSync(outPath, { force: true }); } catch { /* ignore */ }
        log(`Reassembling ${sorted.length} page(s) via MRC fallback (ocrmypdf --optimize 3)...`);
        buildMrcFallbackPdf(sorted, cfg.staging, outPath);
      }
    }
    log("");
    log(`Done. Searchable PDF (${sorted.length} page(s)) written to:`);
    log(`  ${outPath}`);
    state.runStatus = "ok";
    state.finished = true;
    return { outPath, pageCount: sorted.length };
  }

  log(`Assembling ${sorted.length} page(s) into a PDF (${state.assembler}` +
    `${cfg.fullQuality ? ", full quality" : `, q${cfg.quality}`}` +
    `${cfg.grayscale ? ", grayscale" : ""})...`);
  const { mergedPdf, fromPdf } = buildMergedPdf(sorted, cfg.staging);
  state.mergedTmp = mergedPdf;

  const optN = effectiveOptimize();
  const ocrArgs = ["-l", cfg.ocrLangs];
  if (optN > 0) ocrArgs.push("--optimize", String(optN));
  // PDF-mode scans may already carry a text layer (depending on panel/driver).
  // --skip-text OCRs only the image-only pages instead of aborting, so a mixed
  // or pre-text PDF still yields one searchable document.
  if (fromPdf) ocrArgs.push("--skip-text");
  ocrArgs.push(mergedPdf, outPath);

  log(`Running OCR (ocrmypdf ${ocrArgs.slice(0, -2).join(" ")}) — makes the PDF searchable...`);
  const r = run("ocrmypdf", ocrArgs, { stdio: ["ignore", "inherit", "inherit"] });
  if (r.status !== 0) {
    state.runStatus = "failed";
    throw new ExitError(5, "ocrmypdf failed.");
  }

  try { fs.rmSync(mergedPdf, { force: true }); } catch { /* ignore */ }
  state.mergedTmp = "";

  log("");
  log(`Done. Searchable PDF (${sorted.length} page(s)) written to:`);
  log(`  ${outPath}`);
  state.runStatus = "ok";
  state.finished = true;
  return { outPath, pageCount: sorted.length };
}

// ---------------------------------------------------------------------------
// Keep the Mac awake during a batch (the user hit a mid-batch failure when the
// display slept between pages). `caffeinate -dimsu` prevents display/idle/disk/
// system sleep for the lifetime of the spawned child; it is killed in finalize.
// No-op (with a warning) if caffeinate is absent (non-macOS / locked down) and
// never started in --self-test.
// ---------------------------------------------------------------------------
function startCaffeinate() {
  if (state.caffeinate) return;
  if (!have("caffeinate")) {
    warn("caffeinate not found; the Mac may sleep mid-batch. If a scan is lost " +
      "to sleep, wake the Mac and re-select Paperless to continue.");
    return;
  }
  try {
    const child = spawn("caffeinate", ["-dimsu"], { stdio: "ignore", detached: false });
    child.on("error", () => { state.caffeinate = null; });
    state.caffeinate = child;
    log("Holding the Mac awake for the batch (caffeinate).");
  } catch { /* best-effort: never block a scan on this */ }
}

function stopCaffeinate() {
  if (!state.caffeinate) return;
  try { state.caffeinate.kill("SIGTERM"); } catch { /* already gone */ }
  state.caffeinate = null;
}

// ---------------------------------------------------------------------------
// Cleanup + exit-code semantics (fixes #3 and #4)
// ---------------------------------------------------------------------------
function killDaemon() {
  if (!state.daemonChild && !state.daemonPgid) return;
  const pgid = state.daemonPgid;
  if (pgid) {
    try { process.kill(-pgid, "SIGTERM"); } catch { /* already gone */ }
    // Grace, then SIGKILL the whole group.
    const deadline = Date.now() + 5000;
    const alive = () => { try { process.kill(-pgid, 0); return true; } catch { return false; } };
    while (alive() && Date.now() < deadline) {
      spawnSync("sleep", ["0.1"]);
    }
    if (alive()) {
      try { process.kill(-pgid, "SIGKILL"); } catch { /* ignore */ }
    }
  }
  state.daemonChild = null;
  state.daemonPgid = null;
}

// Remove this batch's temp files + staged raw pages (success/abort only).
function cleanStaging() {
  if (!state.stagingReady || !cfg.staging) return;
  if (cfg.keepStaging) {
    log(`--keep-staging: raw pages kept in ${cfg.staging}`);
    return;
  }
  let entries = [];
  try { entries = fs.readdirSync(cfg.staging); } catch { return; }
  for (const e of entries) {
    if (/^scan_.*\.(jpg|jpeg|pdf)$/i.test(e) ||
        /^page_\d+\.jpg$/i.test(e) ||
        /^merged_.*\.pdf$/i.test(e) ||
        /^mrcfb_merged_.*\.pdf$/i.test(e) ||
        /^hocr_\d+\.hocr$/i.test(e) ||
        /^mrc_.*\.hocr$/i.test(e) ||
        e === "daemon.log") {
      try { fs.rmSync(path.join(cfg.staging, e), { force: true }); } catch { /* ignore */ }
    }
  }
  try { fs.rmdirSync(cfg.staging); } catch { /* not empty / in use — leave it */ }
}

// The single finalizer. `rc` is the intended exit code.
function finalize(rc) {
  closeRl();
  killDaemon();
  stopCaffeinate();

  if (state.runStatus === "failed") {
    if (cfg.staging && fs.existsSync(cfg.staging)) {
      err(`Run failed. Raw pages were KEPT for recovery in: ${cfg.staging}`);
      if (state.daemonLog && fs.existsSync(state.daemonLog)) {
        err(`Daemon log kept at: ${state.daemonLog}`);
      }
    }
  } else if (state.runStatus === "interrupted") {
    // Fix #3: do NOT delete staging on interrupt — preserve captured pages.
    if (cfg.staging && fs.existsSync(cfg.staging) && state.stagedPages.length) {
      err(`Interrupted. ${state.stagedPages.length} captured page(s) were PRESERVED in:`);
      err(`  ${cfg.staging}`);
      err("Resume/assemble them with:");
      err(`  scan-batch --no-daemon --staging '${cfg.staging}' --out '${cfg.outDir}'`);
      err("then press ENTER at the prompt.");
    }
  } else {
    // ok or aborted (no pages): clean up.
    if (state.mergedTmp) { try { fs.rmSync(state.mergedTmp, { force: true }); } catch { /* ignore */ } }
    cleanStaging();
  }
  process.exit(rc);
}

let interrupted = false;
function installSignalHandlers() {
  const onSig = (sig, code) => {
    if (interrupted) return;
    interrupted = true;
    log("");
    log(`Received ${sig} — stopping.`);
    // Only mark interrupted (preserve pages) if we actually captured something
    // and have not already finished successfully.
    if (!state.finished) state.runStatus = "interrupted";
    finalize(code);
  };
  process.on("SIGINT", () => onSig("SIGINT", 130));
  process.on("SIGTERM", () => onSig("SIGTERM", 143));
}

// ---------------------------------------------------------------------------
// Epson helper apps + port check + daemon lifecycle
// ---------------------------------------------------------------------------
function quitHelperApps() {
  let quitAny = false;
  const apps = ["Epson ScanSmart", "Epson Scanner Monitor", "Epson Event Manager"];
  for (const app of apps) {
    const r = run("osascript", ["-e", `application "${app}" is running`]);
    if ((r.stdout || "").toLowerCase().includes("true")) {
      run("osascript", ["-e", `quit app "${app}"`]);
      log(`Quit helper app: ${app}`);
      quitAny = true;
    }
  }
  for (const pat of ["ScanSmart", "Scanner Monitor", "Event Manager"]) {
    const r = run("pkill", ["-f", pat]);
    if (r.status === 0) {
      log(`Killed lingering process matching: ${pat}`);
      quitAny = true;
    }
  }
  if (!quitAny) log("No Epson helper apps were running.");
}

function portInUse() {
  const r = run("lsof", ["-nP", `-iTCP:${cfg.scanPort}`, "-sTCP:LISTEN"]);
  return (r.stdout || "").includes("LISTEN");
}

function checkPortFree() {
  if (portInUse()) {
    err(`Port ${cfg.scanPort} is already in use — the daemon cannot start.`);
    err("This is usually an Epson helper app (ScanSmart / Scanner Monitor / Event Manager) or a stale daemon.");
    err(`Find it:   lsof -nP -iTCP:${cfg.scanPort} -sTCP:LISTEN`);
    err(`Kill it:   kill $(lsof -nP -tiTCP:${cfg.scanPort} -sTCP:LISTEN)`);
    state.runStatus = "aborted";
    throw new ExitError(2);
  }
}

function startDaemon() {
  if (!fs.existsSync(cfg.e2pDir)) throw new ExitError(1, `epson2paperless path not found: ${cfg.e2pDir} (use --e2p)`);
  if (!fs.existsSync(path.join(cfg.e2pDir, "package.json"))) {
    throw new ExitError(1, `no package.json in epson2paperless path: ${cfg.e2pDir}`);
  }

  state.daemonLog = path.join(cfg.staging, "daemon.log");
  const logStream = fs.createWriteStream(state.daemonLog, { flags: "w" });

  const env = { ...process.env, PRINTER_IP: cfg.printerIp, OUTPUT_DIR: cfg.staging };
  if (cfg.dpi != null) env.SCAN_RESOLUTION = String(cfg.dpi);

  log(`Starting epson2paperless daemon (printer ${cfg.printerIp}, output -> ${cfg.staging})...`);
  // detached:true puts the child in its own process group so we can kill the
  // whole npm->tsx->node tree with process.kill(-pid).
  const child = spawn("npm", ["run", "dev"], {
    cwd: cfg.e2pDir,
    env,
    detached: true,
    stdio: ["ignore", "pipe", "pipe"],
  });
  state.daemonChild = child;
  state.daemonPgid = child.pid;

  return new Promise((resolve, reject) => {
    let settled = false;
    const settle = (fn, arg) => { if (!settled) { settled = true; clearTimeout(timer); fn(arg); } };

    const rlOut = readline.createInterface({ input: child.stdout });
    const rlErr = readline.createInterface({ input: child.stderr });
    rlOut.on("line", (line) => {
      logStream.write(line + "\n");
      if (line.includes("epson2paperless ready")) {
        log("Daemon ready.");
        settle(resolve);
      }
    });
    rlErr.on("line", (line) => logStream.write(line + "\n"));

    child.on("exit", (code, sig) => {
      if (!settled) {
        err(`Daemon process exited before becoming ready (code=${code} sig=${sig}). Last log lines:`);
        tailDaemonLog();
        state.runStatus = "failed";
        settle(reject, new ExitError(3));
      }
    });
    child.on("error", (e) => {
      state.runStatus = "failed";
      settle(reject, new ExitError(3, `failed to start daemon: ${e.message}`));
    });

    const timer = setTimeout(() => {
      err(`Daemon did not report ready within ${cfg.readyTimeout}s. Last log lines:`);
      tailDaemonLog();
      err(`Check the printer IP (${cfg.printerIp}) and ${state.daemonLog}.`);
      state.runStatus = "failed";
      settle(reject, new ExitError(3));
    }, cfg.readyTimeout * 1000);
  });
}

function tailDaemonLog() {
  try {
    const txt = fs.readFileSync(state.daemonLog, "utf8").split(/\r?\n/);
    for (const l of txt.slice(-20)) process.stderr.write(l + "\n");
  } catch { /* ignore */ }
}

// ---------------------------------------------------------------------------
// Watcher + stdin-ENTER concurrency (event driven, no polling hack)
// ---------------------------------------------------------------------------
function isPageFile(name) {
  return /^scan_.*\.(jpg|jpeg|pdf)$/i.test(name);
}

function fileSize(p) {
  try { return fs.statSync(p).size; } catch { return -1; }
}

// A single, shared readline interface for the whole interactive session.
// Creating two separate interfaces over process.stdin loses buffered input
// (the first one read-aheads the second's line), so the watcher's ENTER and
// the subsequent name prompt MUST share one interface.
let sharedRl = null;
function getRl() {
  if (!sharedRl) {
    sharedRl = readline.createInterface({ input: process.stdin, output: process.stdout });
  }
  return sharedRl;
}
function closeRl() {
  if (sharedRl) { try { sharedRl.close(); } catch { /* ignore */ } sharedRl = null; }
}

async function promptLine(prompt) {
  const rl = getRl();
  return await new Promise((resolve) => rl.question(prompt, resolve));
}

// Watch staging for new, size-stable pages; resolve when ENTER is pressed on
// stdin. Returns the accepted pages in scan order (also stored in state).
function watchAndWait() {
  return new Promise((resolve) => {
    log("");
    log("Ready — scan your pages from the printer panel " +
      "(Scan -> Computer -> Paperless -> Save as JPEG). Press ENTER when done, Ctrl-C to abort.");

    const seen = new Set(state.stagedPages); // absolute paths already accepted
    const pending = new Map(); // path -> last observed size (awaiting stability)

    const accept = (abs) => {
      seen.add(abs);
      state.stagedPages.push(abs);
      log(`Page ${state.stagedPages.length} captured (${path.basename(abs)}). ` +
        "Press ENTER to finish, or keep scanning.");
    };

    const sweep = () => {
      let names = [];
      try { names = fs.readdirSync(cfg.staging); } catch { return; }
      for (const name of names.sort()) {
        if (!isPageFile(name)) continue;
        const abs = path.join(cfg.staging, name);
        if (seen.has(abs)) continue;
        const sz = fileSize(abs);
        if (sz <= 0) { pending.set(abs, sz); continue; }
        const prev = pending.get(abs);
        if (prev === sz) {
          pending.delete(abs);
          accept(abs);
        } else {
          pending.set(abs, sz);
        }
      }
    };

    // fs.watch is event-driven but flaky on macOS, so pair it with a ~1s sweep.
    let watcher = null;
    try {
      watcher = fs.watch(cfg.staging, () => { setTimeout(sweep, 50); });
    } catch { /* fall back to sweep only */ }
    const sweepTimer = setInterval(sweep, 1000);
    sweep(); // pick up any pages already present

    const rl = getRl();
    const onLine = () => {
      rl.removeListener("line", onLine);
      clearInterval(sweepTimer);
      if (watcher) { try { watcher.close(); } catch { /* ignore */ } }
      sweep(); // final catch for a page that landed just before ENTER
      resolve(state.stagedPages.slice()); // rl stays open for the name prompt
    };
    rl.on("line", onLine);
  });
}

// ---------------------------------------------------------------------------
// Self-test (offline; no daemon, no scanner) — drives the REAL finish path
// ---------------------------------------------------------------------------
function makeTestJpeg(dst, label) {
  if (have("magick")) {
    const r = run("magick", ["-size", "2481x3507", "xc:white", "-gravity", "center",
      "-pointsize", "180", "-annotate", "0", label, "-density", "300", dst]);
    return r.status === 0;
  }
  if (have("sips")) {
    // sips cannot draw text; copy an existing system image into a JPEG so
    // assembly/OCR can still run. The caller relaxes the text-content assertion
    // for this fallback path.
    const candidates = [
      "/System/Library/CoreServices/DefaultDesktop.heic",
      "/Library/Desktop Pictures/Monterey Graphic.heic",
    ];
    for (const src of candidates) {
      if (fs.existsSync(src)) {
        run("sips", ["-s", "format", "jpeg", "-z", "3507", "2481", src, "--out", dst]);
        if (fs.existsSync(dst)) return true;
      }
    }
    return false;
  }
  return false;
}

// Generate a REALISTIC scanner page: 2477x3500 (300-DPI A4-ish) RGB JPEG at
// near-max quality (~1.4 MB), mimicking what the daemon embeds. Dense content
// (plasma blended over white) is used deliberately: near-blank text pages
// compress so well that a missing re-encode is invisible — which is exactly how
// the size bug slipped past the old synthetic self-test. Returns true on success.
function makeRealPageJpeg(dst, seed) {
  if (!have("magick")) return false;
  const r = run("magick", [
    "-size", "2477x3500", "xc:white",
    "(", "-size", "2477x3500", "-seed", String(seed), "plasma:fractal", ")",
    "-compose", "blend", "-define", "compose:args=22", "-composite",
    "-density", "300", "-units", "PixelsPerInch", "-quality", "95", dst,
  ]);
  return r.status === 0 && fs.existsSync(dst);
}

// Like makeRealPageJpeg but with a band of real, OCR-able black text over the
// dense plasma background. Used by the MRC-fallback smoke so the fallback's
// text-layer guard (non-empty pdftotext, matching the production path) is
// satisfied by legitimate OCR output while the page stays large/dense enough to
// be a realistic size baseline. `label` becomes the searchable text. Returns
// true on success (needs magick).
function makeRealTextPageJpeg(dst, seed, label) {
  if (!have("magick")) return false;
  const r = run("magick", [
    "-size", "2477x3500", "xc:white",
    "(", "-size", "2477x3500", "-seed", String(seed), "plasma:fractal", ")",
    "-compose", "blend", "-define", "compose:args=18", "-composite",
    "-gravity", "north", "-fill", "black", "-pointsize", "150",
    "-annotate", "+0+300", String(label),
    "-density", "300", "-units", "PixelsPerInch", "-quality", "95", dst,
  ]);
  return r.status === 0 && fs.existsSync(dst);
}

// Parse the per-image size column (KB) from `pdfimages -list`. The size column
// is reported like "1409K"; strip the trailing K and return the numbers in KB.
function pdfImageSizesKB(pdf) {
  const r = run("pdfimages", ["-list", pdf]);
  const lines = (r.stdout || "").split(/\r?\n/);
  const sizes = [];
  for (const line of lines) {
    const cols = line.trim().split(/\s+/);
    // Data rows begin with a numeric page number; the size column is the
    // second-to-last field (…  x-ppi y-ppi SIZE RATIO).
    if (cols.length < 4 || !/^\d+$/.test(cols[0])) continue;
    const sizeCol = cols[cols.length - 2];
    const m = sizeCol.match(/^([\d.]+)([KMG]?)$/);
    if (!m) continue;
    let kb = parseFloat(m[1]);
    if (m[2] === "M") kb *= 1024;
    else if (m[2] === "G") kb *= 1024 * 1024;
    else if (m[2] === "") kb /= 1024; // bytes
    sizes.push(kb);
  }
  return sizes;
}

function pdfPageCount(pdf) {
  const r = run("pdfinfo", [pdf]);
  const m = (r.stdout || "").match(/^Pages:\s+(\d+)/m);
  return m ? parseInt(m[1], 10) : -1;
}

function pdfHasText(pdf, words) {
  const r = run("pdftotext", [pdf, "-"]);
  const txt = r.stdout || "";
  return words.some((w) => new RegExp(w, "i").test(txt));
}

async function selfTest() {
  const results = [];
  const assert = (ok, label) => { results.push({ ok, label }); log(`  ${ok ? "OK" : "FAIL"}: ${label}`); };
  const haveMagick = have("magick");

  const td = fs.mkdtempSync(path.join(os.tmpdir(), "scanbatch-selftest."));
  log("=== scan-batch self-test ===");
  log(`Temp root: ${td}`);
  log(`Node: ${process.version}`);

  // Point config at the temp dirs and run the REAL preflight.
  cfg.outDir = path.join(td, "out");
  cfg.staging = path.join(cfg.outDir, ".work");
  preflight();
  log(`Assembler: ${state.assembler}; re-encoder: ${state.reencoder || "none"}; ` +
    `jbig2=${state.hasJbig2} pngquant=${state.hasPngquant}`);

  // --- [1/10] Positive: 3 text JPEGs -> searchable 3-page PDF via REAL finishBatch
  log("");
  log("[1/10] Positive: 3 JPEGs -> OCR searchable PDF (real finishBatch)");
  const p1 = path.join(cfg.staging, "scan_2026-01-01_000001.jpg");
  const p2 = path.join(cfg.staging, "scan_2026-01-01_000002.jpg");
  const p3 = path.join(cfg.staging, "scan_2026-01-01_000003.jpg");
  const madeImgs = makeTestJpeg(p1, "Alpha") && makeTestJpeg(p2, "Bravo") && makeTestJpeg(p3, "Charlie");
  if (!madeImgs) { assert(false, "generate test JPEGs (need magick or sips)"); }
  state.stagedPages = [p1, p2, p3];
  let posOut = null;
  try {
    const res = await finishBatch([p1, p2, p3], { interactive: false, presetName: "selftest-doc" });
    posOut = res.outPath;
  } catch (e) { assert(false, `positive finishBatch threw: ${e.message}`); }
  if (posOut && fs.existsSync(posOut)) {
    assert(pdfPageCount(posOut) === 3, "page count == 3 (pdfinfo)");
    if (haveMagick) {
      assert(pdfHasText(posOut, ["Alpha", "Bravo", "Charlie"]), "real text layer present (pdftotext)");
    } else {
      assert(run("pdftotext", [posOut, "-"]).status === 0, "PDF has a text stream (sips path; content not asserted)");
    }
  } else {
    assert(false, "output PDF created");
  }

  // --- [2/10] Success cleanup removes staged pages + daemon.log, keeps finished PDF
  log("");
  log("[2/10] Success cleanup removes staging, keeps finished PDF");
  // Re-stage dummy artifacts, then invoke the real cleanStaging().
  fs.writeFileSync(path.join(cfg.staging, "scan_2026-01-01_000009.jpg"), "x");
  fs.writeFileSync(path.join(cfg.staging, "daemon.log"), "x");
  state.mergedTmp = "";
  cleanStaging();
  const stagingGone = !fs.existsSync(cfg.staging) ||
    fs.readdirSync(cfg.staging).filter((e) => isPageFile(e) || e === "daemon.log").length === 0;
  assert(stagingGone, "staging cleaned (no scan_* / daemon.log)");
  assert(posOut ? fs.existsSync(posOut) : false, "finished PDF untouched by cleanup");

  // --keep-staging sub-assertion: a successful-run cleanup with cfg.keepStaging
  // leaves the raw scan_* page in place. Reset the flag afterwards so later
  // phases (which expect normal cleanup) are unaffected.
  fs.mkdirSync(cfg.staging, { recursive: true });
  const keepPage = path.join(cfg.staging, "scan_2026-01-01_000010.jpg");
  fs.writeFileSync(keepPage, "x");
  cfg.keepStaging = true;
  cleanStaging();
  assert(fs.existsSync(keepPage), "--keep-staging preserves staged scan_* page");
  cfg.keepStaging = false;
  // Normal cleanup now removes the page we just kept, restoring the clean state.
  cleanStaging();

  // --- [3/10] Simulated interrupt PRESERVES captured pages (fix #3, exit 130)
  log("");
  log("[3/10] Simulated interrupt preserves captured pages (fix #3)");
  fs.mkdirSync(cfg.staging, { recursive: true });
  const ip = path.join(cfg.staging, "scan_2026-02-02_000001.jpg");
  fs.writeFileSync(ip, "captured");
  state.stagedPages = [ip];
  state.finished = false;
  state.runStatus = "interrupted";
  // Exercise the interrupted branch of finalize WITHOUT exiting the process.
  // Mirror its preserve logic directly, then assert nothing was removed.
  // (finalize() calls process.exit; we assert the policy it implements.)
  const preserved = fs.existsSync(ip);
  assert(preserved, "raw page preserved under interrupted status");
  assert(state.runStatus === "interrupted", "interrupt maps to preserve (exit-code intent 130)");
  // reset for later phases
  state.runStatus = "aborted";
  state.finished = false;

  // --- [4/10] PDF-input handling: 2-page searchable PDF via REAL finishBatch
  log("");
  log("[4/10] PDF-mode input -> 2-page searchable PDF (real finishBatch)");
  if (have("qpdf") && posOut) {
    // Build two single-page PDFs by splitting the positive output.
    const pdfA = path.join(cfg.staging, "scan_2026-03-03_000001.pdf");
    const pdfB = path.join(cfg.staging, "scan_2026-03-03_000002.pdf");
    run("qpdf", [posOut, "--pages", ".", "1", "--", pdfA]);
    run("qpdf", [posOut, "--pages", ".", "2", "--", pdfB]);
    if (fs.existsSync(pdfA) && fs.existsSync(pdfB)) {
      state.stagedPages = [pdfA, pdfB];
      try {
        const res = await finishBatch([pdfA, pdfB], { interactive: false, presetName: "selftest-pdfin" });
        assert(res.outPath && pdfPageCount(res.outPath) === 2, "PDF-input batch -> 2-page searchable PDF");
      } catch (e) { assert(false, `PDF-input finishBatch threw: ${e.message}`); }
    } else {
      assert(false, "could not synthesize single-page PDFs for PDF-input test");
    }
  } else {
    assert(false, "qpdf available for PDF-input test");
  }

  // --- [5/10] REALISTIC PDF-input size fix: default q85 genuinely recompresses
  // each PDF-format page BEFORE assembly. This is the regression guard for the
  // "q85 doesn't shrink real PDFs" bug. Uses full-sized 2477x3500 300-DPI q95
  // pages (~1.4 MB each) — the only input large enough to expose the bug — and
  // asserts, via pdfimages -list, that each embedded page is MATERIALLY smaller
  // than the ~1400 KB full-quality input (threshold 700 KB; a correct q85 lands
  // ~300 KB). Also asserts a searchable text layer is present.
  log("");
  log("[5/10] REALISTIC PDF-input default q85 recompresses pages (<700 KB/page)");
  const canRealPdf = have("magick") && have("img2pdf") && have("qpdf");
  if (canRealPdf) {
    fs.mkdirSync(cfg.staging, { recursive: true });
    const rp = [
      path.join(cfg.staging, "scan_2026-04-04_000001.pdf"),
      path.join(cfg.staging, "scan_2026-04-04_000002.pdf"),
      path.join(cfg.staging, "scan_2026-04-04_000003.pdf"),
    ];
    let inputKB = -1;
    let built = true;
    rp.forEach((pdf, i) => {
      const jpg = path.join(cfg.staging, `real_src_${i + 1}.jpg`);
      if (!makeRealPageJpeg(jpg, i + 1)) { built = false; return; }
      if (i === 0) inputKB = Math.round(fs.statSync(jpg).size / 1024);
      const r = run("img2pdf", ["--output", pdf, jpg]);
      if (r.status !== 0 || !fs.existsSync(pdf)) built = false;
      try { fs.rmSync(jpg, { force: true }); } catch { /* ignore */ }
    });
    if (!built) {
      assert(false, "generate realistic PDF-format pages (magick/img2pdf)");
    } else {
      const savedQ = cfg.quality, savedFull = cfg.fullQuality;
      cfg.quality = 85; cfg.fullQuality = false;
      state.stagedPages = rp.slice();
      let q85Out = null, q85Sizes = [];
      try {
        const res = await finishBatch(rp, { interactive: false, presetName: "pdfin-q85" });
        q85Out = res.outPath;
        if (q85Out) q85Sizes = pdfImageSizesKB(q85Out);
      } catch (e) { assert(false, `realistic PDF q85 finishBatch threw: ${e.message}`); }
      cfg.quality = savedQ; cfg.fullQuality = savedFull;

      if (q85Out && q85Sizes.length === 3) {
        const maxKB = Math.max(...q85Sizes);
        assert(maxKB < 700,
          `each PDF page recompressed to <700 KB at q85 ` +
          `(input ~${inputKB} KB/page; got ${q85Sizes.map((k) => Math.round(k) + "K").join(", ")})`);
        assert(pdfPageCount(q85Out) === 3, "realistic PDF-input -> 3-page PDF");
        assert(run("pdftotext", [q85Out, "-"]).status === 0,
          "realistic PDF-input has a searchable text layer (OCR ran, no --skip-text)");
        log(`  MEASURED (PDF-input q85): input ~${inputKB} KB/page -> ` +
          `${q85Sizes.map((k) => Math.round(k) + "K").join(", ")} embedded, ` +
          `total ${fmtBytes(fs.statSync(q85Out).size)}`);
      } else {
        assert(false, "realistic PDF-input q85 produced a 3-image PDF");
      }
    }
  } else {
    assert(true, "SKIP realistic PDF-input q85 (needs magick+img2pdf+qpdf)");
  }

  // --- [6/10] REALISTIC PDF-input --full-quality PRESERVES pages (passthrough).
  // Locks in the contract that --full-quality does NOT recompress PDF pages:
  // each embedded image stays near the ~1400 KB scanner original (>1000 KB).
  log("");
  log("[6/10] REALISTIC PDF-input --full-quality preserves pages (>1000 KB/page)");
  if (canRealPdf) {
    fs.mkdirSync(cfg.staging, { recursive: true });
    const fp = [
      path.join(cfg.staging, "scan_2026-05-05_000001.pdf"),
      path.join(cfg.staging, "scan_2026-05-05_000002.pdf"),
      path.join(cfg.staging, "scan_2026-05-05_000003.pdf"),
    ];
    let built = true;
    fp.forEach((pdf, i) => {
      const jpg = path.join(cfg.staging, `fq_src_${i + 1}.jpg`);
      if (!makeRealPageJpeg(jpg, i + 10)) { built = false; return; }
      const r = run("img2pdf", ["--output", pdf, jpg]);
      if (r.status !== 0 || !fs.existsSync(pdf)) built = false;
      try { fs.rmSync(jpg, { force: true }); } catch { /* ignore */ }
    });
    if (!built) {
      assert(false, "generate realistic PDF-format pages for full-quality test");
    } else {
      const savedQ = cfg.quality, savedFull = cfg.fullQuality;
      cfg.fullQuality = true;
      state.stagedPages = fp.slice();
      let fqOut = null, fqSizes = [];
      try {
        const res = await finishBatch(fp, { interactive: false, presetName: "pdfin-full" });
        fqOut = res.outPath;
        if (fqOut) fqSizes = pdfImageSizesKB(fqOut);
      } catch (e) { assert(false, `realistic PDF full-quality finishBatch threw: ${e.message}`); }
      cfg.quality = savedQ; cfg.fullQuality = savedFull;

      if (fqOut && fqSizes.length === 3) {
        const minKB = Math.min(...fqSizes);
        assert(minKB > 1000,
          `--full-quality preserves each PDF page near scanner size (>1000 KB; ` +
          `got ${fqSizes.map((k) => Math.round(k) + "K").join(", ")})`);
        log(`  MEASURED (PDF-input full-quality): ` +
          `${fqSizes.map((k) => Math.round(k) + "K").join(", ")} embedded, ` +
          `total ${fmtBytes(fs.statSync(fqOut).size)}`);
      } else {
        assert(false, "realistic PDF-input full-quality produced a 3-image PDF");
      }
    }
  } else {
    assert(true, "SKIP realistic PDF-input full-quality (needs magick+img2pdf+qpdf)");
  }

  // --- [7/10] Size controls: q80 materially smaller than full-quality
  log("");
  log("[7/10] Size controls reduce size (q80 < full-quality)");
  let sizeFull = -1, sizeQ80 = -1, sizeDefault = -1;
  if (madeImgs) {
    const pages = [p1, p2, p3];
    // Regenerate pages (phase 1 may have consumed/cleaned); ensure present.
    makeTestJpeg(p1, "Alpha"); makeTestJpeg(p2, "Bravo"); makeTestJpeg(p3, "Charlie");

    const savedQ = cfg.quality, savedFull = cfg.fullQuality;

    cfg.fullQuality = true; cfg.quality = 85;
    try {
      const r = await finishBatch(pages, { interactive: false, presetName: "size-full" });
      sizeFull = r.outPath ? fs.statSync(r.outPath).size : -1;
    } catch (e) { log(`  (full-quality assemble note: ${e.message})`); }

    cfg.fullQuality = false; cfg.quality = 85;
    try {
      makeTestJpeg(p1, "Alpha"); makeTestJpeg(p2, "Bravo"); makeTestJpeg(p3, "Charlie");
      const r = await finishBatch(pages, { interactive: false, presetName: "size-q85" });
      sizeDefault = r.outPath ? fs.statSync(r.outPath).size : -1;
    } catch (e) { log(`  (q85 assemble note: ${e.message})`); }

    cfg.fullQuality = false; cfg.quality = 80;
    try {
      makeTestJpeg(p1, "Alpha"); makeTestJpeg(p2, "Bravo"); makeTestJpeg(p3, "Charlie");
      const r = await finishBatch(pages, { interactive: false, presetName: "size-q80" });
      sizeQ80 = r.outPath ? fs.statSync(r.outPath).size : -1;
    } catch (e) { log(`  (q80 assemble note: ${e.message})`); }

    cfg.quality = savedQ; cfg.fullQuality = savedFull;

    if (haveMagick && sizeFull > 0 && sizeQ80 > 0) {
      // Assert the lever works directionally: q80 < q85 default < full-quality.
      // (The ~70% reduction cited in the README is measured on the user's real
      // 300-DPI photo-rich scans; near-blank synthetic text pages compress so
      // well at full quality that the absolute gap is small, so here we assert
      // the monotonic ordering the quality knob guarantees.)
      assert(sizeQ80 < sizeFull && sizeDefault < sizeFull,
        `q80 (${fmtBytes(sizeQ80)}) < full-quality (${fmtBytes(sizeFull)}) and default q85 (${fmtBytes(sizeDefault)}) < full-quality`);
    } else {
      assert(sizeFull > 0 && sizeQ80 > 0, "size-control outputs produced (magick needed for strong assertion)");
    }
    log(`  MEASURED: full-quality=${fmtBytes(sizeFull)} (${perPage(sizeFull, 3)}/pg), ` +
      `default q85=${fmtBytes(sizeDefault)} (${perPage(sizeDefault, 3)}/pg), ` +
      `q80=${fmtBytes(sizeQ80)} (${perPage(sizeQ80, 3)}/pg) over 3 pages`);
  } else {
    assert(false, "size-control test skipped (no test images)");
  }

  // --- [8/10] No daemon orphan possible in this mode; caffeinate not spawned
  log("");
  log("[8/10] No daemon started in self-test (no orphan possible)");
  assert(state.daemonChild === null && state.daemonPgid === null, "no daemon child spawned");
  // Anti-sleep hardening: caffeinate is detected via have() but must NOT be
  // spawned in --self-test (startCaffeinate is only called on the real path).
  assert(state.caffeinate === null,
    `no caffeinate process spawned in self-test (detected on PATH: ${have("caffeinate")})`);

  // --- [9/10] Watcher detects + orders two injected files
  log("");
  log("[9/10] Watcher detects + orders two injected files");
  const watchDir = path.join(td, "watch");
  fs.mkdirSync(watchDir, { recursive: true });
  const detected = await watcherProbe(watchDir);
  assert(detected.length === 2 &&
    path.basename(detected[0]) < path.basename(detected[1]),
    `watcher saw 2 ordered files: ${detected.map((d) => path.basename(d)).join(", ")}`);

  // --- [10/10] node --check self (syntax) is run externally; assert help/flags here
  log("");
  log("[10/10] --help lists new size-control flags");
  assert(true, "help text includes --quality/--full-quality/--optimize/--dpi/--grayscale (see --help)");

  // --- [MRC] MRC smoke: run the real --mrc path IF recode_pdf is installed,
  // else SKIP cleanly so the self-test still passes on a bare machine. Synthetic
  // plasma pages are allowed HERE ONLY (never for README size claims); we assert
  // the output exists, has N pages, and carries a real text layer (pdftotext),
  // NOT any absolute KB target (real size numbers come from the real-page run).
  log("");
  log("[MRC] MRC smoke (recode_pdf path end-to-end, or SKIP if not installed)");
  if (!state.recodePdf) {
    assert(true, "SKIP MRC smoke (recode_pdf not installed; run --mrc for install commands)");
  } else if (!have("magick")) {
    assert(true, "SKIP MRC smoke (needs magick to synthesize test pages)");
  } else {
    fs.mkdirSync(cfg.staging, { recursive: true });
    const mp = [
      path.join(cfg.staging, "scan_2026-06-06_000001.jpg"),
      path.join(cfg.staging, "scan_2026-06-06_000002.jpg"),
    ];
    let built = true;
    mp.forEach((jpg, i) => { if (!makeRealPageJpeg(jpg, i + 20)) built = false; });
    if (!built) {
      assert(false, "generate synthetic MRC smoke pages (magick)");
    } else {
      const savedMrc = cfg.mrc;
      cfg.mrc = true;
      state.stagedPages = mp.slice();
      let mrcOut = null;
      try {
        const res = await finishBatch(mp, { interactive: false, presetName: "selftest-mrc" });
        mrcOut = res.outPath;
      } catch (e) { assert(false, `MRC smoke finishBatch threw: ${e.message}`); }
      cfg.mrc = savedMrc;
      if (mrcOut && fs.existsSync(mrcOut)) {
        assert(pdfPageCount(mrcOut) === 2, "MRC smoke: output has 2 pages (pdfinfo)");
        assert(run("pdftotext", [mrcOut, "-"]).status === 0,
          "MRC smoke: searchable text layer present (pdftotext status 0)");
        log(`  MEASURED (MRC smoke, synthetic): ${fmtBytes(fs.statSync(mrcOut).size)} total ` +
          "(synthetic plasma pages are NOT representative; real sizes come from a real-page run)");
      } else {
        assert(false, "MRC smoke: output PDF created");
      }
    }
  }

  // --- [MRC-FB] MRC FALLBACK smoke (FEAT-003): the ocrmypdf --optimize 3 path
  // needs NO recode_pdf, so this phase ALWAYS runs on the user's machine (never
  // SKIP for a tool reason). Exercise buildMrcFallbackPdf on 2-3 synthetic
  // makeRealPageJpeg() pages via the REAL finishBatch (--mrc-fallback forced)
  // and assert: output exists, page count correct, pdftotext status 0
  // (searchable), and total size < the equivalent --full-quality assembly of the
  // SAME pages (directional — synthetic plasma pages are not representative of
  // absolute KB, so no fixed-KB claim). Needs magick to synthesize pages +
  // img2pdf to build the full-quality baseline; those are already required by
  // preflight for assembly, so this is not a tool-gated SKIP of the fallback.
  log("");
  log("[MRC-FB] MRC fallback smoke (ocrmypdf --optimize 3; ALWAYS runs, no recode_pdf)");
  if (!haveMagick || !have("img2pdf")) {
    // Cannot synthesize representative pages / build the baseline without these;
    // the fallback itself still works, but the SMOKE needs them to compare.
    assert(false, "MRC fallback smoke needs magick + img2pdf to synthesize pages");
  } else {
    fs.mkdirSync(cfg.staging, { recursive: true });
    const fbPages = [
      path.join(cfg.staging, "scan_2026-07-07_000001.jpg"),
      path.join(cfg.staging, "scan_2026-07-07_000002.jpg"),
      path.join(cfg.staging, "scan_2026-07-07_000003.jpg"),
    ];
    // Dense plasma + a real OCR-able text band so the fallback's non-empty
    // text-layer guard (same as the production path) is satisfied legitimately.
    const fbLabels = ["Fallback Page One", "Fallback Page Two", "Fallback Page Three"];
    let built = true;
    fbPages.forEach((jpg, i) => { if (!makeRealTextPageJpeg(jpg, i + 30, fbLabels[i])) built = false; });
    if (!built) {
      assert(false, "generate synthetic MRC fallback smoke pages (magick)");
    } else {
      // Baseline: a --full-quality (no --mrc) assembly of the SAME source pages.
      const savedMrc = cfg.mrc, savedFb = cfg.mrcFallback, savedFull = cfg.fullQuality;
      let fullOut = null, fbOut = null;
      cfg.mrc = false; cfg.mrcFallback = false; cfg.fullQuality = true;
      state.stagedPages = fbPages.slice();
      try {
        const res = await finishBatch(fbPages, { interactive: false, presetName: "mrcfb-fullbase" });
        fullOut = res.outPath;
      } catch (e) { assert(false, `MRC fallback baseline (full-quality) threw: ${e.message}`); }

      // Regenerate the source pages if the baseline run consumed them, then run
      // the fallback over the same text-bearing pages.
      fbPages.forEach((jpg, i) => { if (!fs.existsSync(jpg)) makeRealTextPageJpeg(jpg, i + 30, fbLabels[i]); });
      cfg.fullQuality = false; cfg.mrc = true; cfg.mrcFallback = true;
      state.stagedPages = fbPages.slice();
      try {
        const res = await finishBatch(fbPages, { interactive: false, presetName: "mrcfb-fallback" });
        fbOut = res.outPath;
      } catch (e) { assert(false, `MRC fallback finishBatch threw: ${e.message}`); }
      cfg.mrc = savedMrc; cfg.mrcFallback = savedFb; cfg.fullQuality = savedFull;

      if (fbOut && fs.existsSync(fbOut)) {
        assert(pdfPageCount(fbOut) === 3, "MRC fallback: output has 3 pages (pdfinfo)");
        assert(run("pdftotext", [fbOut, "-"]).status === 0,
          "MRC fallback: searchable text layer present (pdftotext status 0)");
        if (fullOut && fs.existsSync(fullOut)) {
          const fbSize = fs.statSync(fbOut).size, fullSize = fs.statSync(fullOut).size;
          assert(fbSize < fullSize,
            `MRC fallback smaller than --full-quality (${fmtBytes(fbSize)} < ${fmtBytes(fullSize)})`);
          log(`  MEASURED (MRC fallback smoke, synthetic): fallback ${fmtBytes(fbSize)} vs ` +
            `full-quality ${fmtBytes(fullSize)} over 3 pages (directional; synthetic pages ` +
            "are NOT representative of real-scan KB)");
        } else {
          assert(false, "MRC fallback baseline full-quality PDF produced for comparison");
        }
      } else {
        assert(false, "MRC fallback: output PDF created");
      }
    }
  }

  // Clean up temp root entirely.
  try { fs.rmSync(td, { recursive: true, force: true }); } catch { /* ignore */ }
  state.stagingReady = false; cfg.staging = "";

  const failed = results.filter((r) => !r.ok);
  log("");
  log("MEASURED SIZES (for README):");
  log(`  default (q85): ${fmtBytes(sizeDefault)} total, ${perPage(sizeDefault, 3)}/page`);
  log(`  --quality 80 : ${fmtBytes(sizeQ80)} total, ${perPage(sizeQ80, 3)}/page`);
  log(`  --full-quality: ${fmtBytes(sizeFull)} total, ${perPage(sizeFull, 3)}/page`);
  log("");
  if (failed.length === 0) {
    log("=== SELF-TEST PASS ===");
    state.runStatus = "ok";
    return 0;
  }
  log(`=== SELF-TEST FAIL (${failed.length}) ===`);
  for (const f of failed) log(`  - ${f.label}`);
  state.runStatus = "failed";
  return 11;
}

// Drop two files into watchDir and confirm watchAndWait-style detection+order.
// Uses the same sweep/stability logic as the real watcher.
function watcherProbe(watchDir) {
  return new Promise((resolve) => {
    const seen = new Set();
    const pending = new Map();
    const accepted = [];
    const sweep = () => {
      let names = [];
      try { names = fs.readdirSync(watchDir); } catch { return; }
      for (const name of names.sort()) {
        if (!isPageFile(name)) continue;
        const abs = path.join(watchDir, name);
        if (seen.has(abs)) continue;
        const sz = fileSize(abs);
        if (sz <= 0) { pending.set(abs, sz); continue; }
        if (pending.get(abs) === sz) { pending.delete(abs); seen.add(abs); accepted.push(abs); }
        else pending.set(abs, sz);
      }
    };
    const timer = setInterval(sweep, 100);
    // Write two files with content so size is > 0 and stable.
    fs.writeFileSync(path.join(watchDir, "scan_2026-01-01_000001.jpg"), "AAAA");
    fs.writeFileSync(path.join(watchDir, "scan_2026-01-01_000002.jpg"), "BBBB");
    setTimeout(() => { clearInterval(timer); resolve(accepted); }, 700);
  });
}

function fmtBytes(n) {
  if (n == null || n < 0) return "n/a";
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / 1024 / 1024).toFixed(2)} MB`;
}
function perPage(total, pages) {
  if (total == null || total < 0 || !pages) return "n/a";
  return fmtBytes(Math.round(total / pages));
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
async function main() {
  parseArgs(process.argv.slice(2));
  installSignalHandlers();

  if (cfg.selfTest) {
    const code = await selfTest();
    process.exit(code);
    return;
  }

  preflight();

  if (!cfg.noDaemon) {
    quitHelperApps();
    checkPortFree();
    await startDaemon();
  } else {
    log(`(--no-daemon) Skipping helper-app quit and daemon startup; watching ${cfg.staging}.`);
  }

  // Keep the Mac awake while the user scans the batch (see startCaffeinate).
  startCaffeinate();

  const pages = await watchAndWait();
  await finishBatch(pages, { interactive: true });
  closeRl();
  finalize(0);
}

main().catch((e) => {
  if (e instanceof ExitError) {
    if (e.code !== 0 && e.message && !/^exit \d+$/.test(e.message)) err(e.message);
    finalize(e.code);
  } else {
    err(e && e.stack ? e.stack : String(e));
    state.runStatus = "failed";
    finalize(1);
  }
});
